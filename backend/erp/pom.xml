<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    
    <parent>
        <groupId>cn.aiedge</groupId>
        <artifactId>ai-ready-backend</artifactId>
        <version>0.2.0</version>
        <relativePath>../pom.xml</relativePath>
    </parent>
    
    <groupId>cn.aiedge.erp</groupId>
    <artifactId>erp</artifactId>
    <packaging>pom</packaging>
    
    <name>ERP 模块</name>
    <description>企业资源计划模块</description>
    
    <modules>
        <module>party</module>
        <module>purchase</module>
        <module>erp-purchase-return</module>
        <module>sales</module>
        <module>erp-stock</module>
        <module>erp-order</module>
        <module>erp-expense</module>
        <module>erp-supplier-portal</module>
        <module>erp-batch-sn</module>
        <module>invoice</module>
        <module>finance</module>
        <module>erp-metrics</module>
        <module>price-engine</module>
        <module>erp-printing</module>
        <module>erp-signature</module>
        <module>erp-delivery-route</module>
        <module>erp-payment</module>
        <module>erp-product-kit</module>
        <module>erp-sale-return</module>
        <module>erp-b2b-mall</module>
        <module>erp-fixed-asset</module>
        <module>erp-budget</module>
        <module>erp-purchase-exchange</module>
        <module>erp-purchase-inbound</module>
        <module>erp-monitor</module>
        <module>erp-sale-outbound</module>
        <module>customer</module>
    </modules>
    
    <properties>
        <erp-common.version>0.2.0</erp-common.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>
    
    <dependencies>
        <!-- 核心公共模块（BusinessException等） -->
        <dependency>
            <groupId>cn.aiedge</groupId>
            <artifactId>core-common</artifactId>
        </dependency>
    </dependencies>

    <dependencyManagement>
        <dependencies>
            <!-- ERP 通用模块 -->
            <dependency>
                <groupId>cn.aiedge</groupId>
                <artifactId>erp-common</artifactId>
                <version>${erp-common.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>
</project>