# AI-Ready 生产环境配置
# 版本: v1.0.0

# 部署信息
ENV=prod
APP_NAME=ai-ready
APP_PORT=8080
APP_VERSION=latest

# 远程主机配置
DEPLOY_HOST=prod.ai-ready.cn
DEPLOY_USER=deploy
REMOTE_APP_DIR=/opt/ai-ready/prod
REMOTE_LOG_DIR=/var/log/ai-ready/prod
REMOTE_BACKUP_DIR=/opt/ai-ready/backups/prod

# 数据库配置 - 主从配置
DB_HOST=prod-db.ai-ready.cn
DB_PORT=5432
DB_NAME=ai_ready_prod
DB_USER=ai_ready
DB_PASSWORD=prod_secure_password
DB_REPLICA_HOST=prod-db-replica.ai-ready.cn

# Redis配置 - Cluster模式
REDIS_HOST=prod-redis.ai-ready.cn
REDIS_PORT=6379
REDIS_PASSWORD=prod_redis_secure_pass
REDIS_CLUSTER_NODES=prod-redis-1:6379,prod-redis-2:6379,prod-redis-3:6379

# Nacos配置 - 集群模式
NACOS_HOST=prod-nacos.ai-ready.cn
NACOS_PORT=8848
NACOS_CLUSTER_NODES=prod-nacos-1:8848,prod-nacos-2:8848,prod-nacos-3:8848

# 日志级别
LOG_LEVEL=WARN

# JVM配置 - 生产优化
JAVA_OPTS="-Xms2048m -Xmx4096m -XX:+UseG1GC -XX:MaxGCPauseMillis=200 -XX:+UseStringDeduplication"

# 健康检查配置
HEALTH_CHECK_URL=https://api.ai-ready.cn/actuator/health
HEALTH_CHECK_TIMEOUT=180

# 通知配置
NOTIFY_ENABLED=true
NOTIFY_WEBHOOK=https://hooks.slack.com/services/YOUR/PROD/WEBHOOK
NOTIFY_EMAIL=ops@ai-ready.cn

# 安全配置
SSL_ENABLED=true
SSL_CERT_PATH=/etc/ssl/certs/ai-ready.crt
SSL_KEY_PATH=/etc/ssl/private/ai-ready.key

# 备份配置
BACKUP_ENABLED=true
BACKUP_SCHEDULE="0 2 * * *"
BACKUP_RETENTION_DAYS=30
