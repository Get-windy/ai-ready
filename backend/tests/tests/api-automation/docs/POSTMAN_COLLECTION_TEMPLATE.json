    {
      "name": "5. 安全测试",
      "description": "安全相关测试用例：SQL注入、XSS、越权等",
      "item": [
        {
          "name": "TC-SEC-001: SQL注入测试",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/users?keyword=' OR '1'='1",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "users"],
              "query": [
                {
                  "key": "keyword",
                  "value": "' OR '1'='1"
                }
              ]
            },
            "description": "安全测试：SQL注入攻击防护"
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('SQL注入被拦截', function() {",
                  "    pm.expect(pm.response.code).to.be.oneOf([400, 403, 200]);",
                  "});",
                  "",
                  "if (pm.response.code === 200) {",
                  "    pm.test('未返回全部数据', function() {",
                  "        var jsonData = pm.response.json();",
                  "        pm.expect(jsonData.data.total).to.be.below(1000);",
                  "    });",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "TC-SEC-002: XSS攻击测试",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"<script>alert('XSS')</script>\",\n  \"contactName\": \"<img src=x onerror=alert('XSS')>\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/crm/customers",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "crm", "customers"]
            },
            "description": "安全测试：XSS攻击防护"
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
