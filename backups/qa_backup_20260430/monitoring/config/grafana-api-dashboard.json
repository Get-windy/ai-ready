{
  "dashboard": {
    "id": null,
    "title": "API监控仪表盘",
    "tags": ["api", "monitoring", "ai-ready"],
    "timezone": "Asia/Shanghai",
    "schemaVersion": 36,
    "refresh": "15s",
    "panels": [
      {
        "id": 1,
        "title": "API可用性",
        "type": "stat",
        "targets": [
          {
            "expr": "(sum(rate(api_requests_total[5m])) - sum(rate(api_errors_total[5m]))) / sum(rate(api_requests_total[5m])) * 100",
            "legendFormat": "可用性"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "percent",
            "min": 0,
            "max": 100,
            "thresholds": {
              "steps": [
                {"color": "red", "value": 0},
                {"color": "yellow", "value": 95},
                {"color": "green", "value": 99}
              ]
            }
          }
        },
        "gridPos": {"h": 8, "w": 6, "x": 0, "y": 0}
      },
      {
        "id": 2,
        "title": "平均响应时间",
        "type": "stat",
        "targets": [
          {
            "expr": "avg(api_response_time_ms)",
            "legendFormat": "平均响应时间"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "ms",
            "thresholds": {
              "steps": [
                {"color": "green", "value": 0},
                {"color": "yellow", "value": 500},
                {"color": "red", "value": 1000}
              ]
            }
          }
        },
        "gridPos": {"h": 8, "w": 6, "x": 6, "y": 0}
      },
      {
        "id": 3,
        "title": "请求总量",
        "type": "stat",
        "targets": [
          {
            "expr": "sum(api_requests_total)",
            "legendFormat": "总请求数"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "short"
          }
        },
        "gridPos": {"h": 8, "w": 6, "x": 12, "y": 0}
      },
      {
        "id": 4,
        "title": "错误率",
        "type": "stat",
        "targets": [
          {
            "expr": "sum(rate(api_errors_total[5m])) / sum(rate(api_requests_total[5m])) * 100",
            "legendFormat": "错误率"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "percent",
            "thresholds": {
              "steps": [
                {"color": "green", "value": 0},
                {"color": "yellow", "value": 1},
                {"color": "red", "value": 5}
              ]
            }
          }
        },
        "gridPos": {"h": 8, "w": 6, "x": 18, "y": 0}
      },
      {
        "id": 5,
        "title": "响应时间趋势",
        "type": "graph",
        "targets": [
          {
            "expr": "avg(api_response_time_ms) by (endpoint)",
            "legendFormat": "{{ endpoint }}"
          }
        ],
        "yAxes": [
          {
            "label": "响应时间 (ms)",
            "min": 0
          }
        ],
        "gridPos": {"h": 10, "w": 12, "x": 0, "y": 8}
      },
      {
        "id": 6,
        "title": "请求量趋势",
        "type": "graph",
        "targets": [
          {
            "expr": "rate(api_requests_total[5m])",
            "legendFormat": "{{ endpoint }}"
          }
        ],
        "yAxes": [
          {
            "label": "请求/秒",
            "min": 0
          }
        ],
        "gridPos": {"h": 10, "w": 12, "x": 12, "y": 8}
      },
      {
        "id": 7,
        "title": "错误率趋势",
        "type": "graph",
        "targets": [
          {
            "expr": "rate(api_errors_total[5m]) / rate(api_requests_total[5m]) * 100",
            "legendFormat": "{{ endpoint }}"
          }
        ],
        "yAxes": [
          {
            "label": "错误率 (%)",
            "min": 0
          }
        ],
        "gridPos": {"h": 10, "w": 12, "x": 0, "y": 18}
      },
      {
        "id": 8,
        "title": "HTTP状态码分布",
        "type": "piechart",
        "targets": [
          {
            "expr": "sum(rate(api_requests_total[5m])) by (status_code)",
            "legendFormat": "{{ status_code }}"
          }
        ],
        "gridPos": {"h": 10, "w": 12, "x": 12, "y": 18}
      },
      {
        "id": 9,
        "title": "各端点性能概览",
        "type": "table",
        "targets": [
          {
            "expr": "avg(api_response_time_ms) by (endpoint)",
            "format": "table",
            "instant": true
          }
        ],
        "gridPos": {"h": 10, "w": 24, "x": 0, "y": 28}
      }
    ],
    "time": {
      "from": "now-1h",
      "to": "now"
    }
  }
}
