<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="cn.aiedge.erp.printing.mapper.SysPrintChainItemMapper">

    <select id="selectByChainIdOrdered" resultType="cn.aiedge.erp.printing.entity.v2.SysPrintChainItem">
        SELECT * FROM sys_print_chain_item
        WHERE chain_id = #{chainId}
        ORDER BY step_order ASC
    </select>

</mapper>
