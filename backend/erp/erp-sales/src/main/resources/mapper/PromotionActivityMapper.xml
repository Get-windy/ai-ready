<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="cn.aiedge.erp.sale.mapper.PromotionActivityMapper">

    <resultMap id="BaseResultMap" type="cn.aiedge.erp.sale.entity.PromotionActivity">
        <id column="id" property="id"/>
        <result column="tenant_id" property="tenantId"/>
        <result column="name" property="name"/>
        <result column="description" property="description"/>
        <result column="type" property="type"/>
        <result column="start_time" property="startTime"/>
        <result column="end_time" property="endTime"/>
        <result column="discount_rate" property="discountRate"/>
        <result column="min_amount" property="minAmount"/>
        <result column="reduction_amount" property="reductionAmount"/>
        <result column="gift_config" property="giftConfig"
                typeHandler="com.baomidou.mybatisplus.extension.handlers.JacksonTypeHandler"/>
        <result column="combo_config" property="comboConfig"
                typeHandler="com.baomidou.mybatisplus.extension.handlers.JacksonTypeHandler"/>
        <result column="customer_levels" property="customerLevels"/>
        <result column="product_ids" property="productIds"/>
        <result column="regions" property="regions"/>
        <result column="max_usage_count" property="maxUsageCount"/>
        <result column="usage_limit_per_customer" property="usageLimitPerCustomer"/>
        <result column="stackable" property="stackable"/>
        <result column="status" property="status"/>
        <result column="deleted" property="deleted"/>
        <result column="create_time" property="createTime"/>
        <result column="update_time" property="updateTime"/>
        <result column="create_by" property="createBy"/>
        <result column="update_by" property="updateBy"/>
    </resultMap>

    <sql id="Base_Column_List">
        id, tenant_id, name, description, type, start_time, end_time,
        discount_rate, min_amount, reduction_amount, gift_config, combo_config,
        customer_levels, product_ids, regions, max_usage_count, usage_limit_per_customer,
        stackable, status, deleted, create_time, update_time, create_by, update_by
    </sql>

    <select id="selectPageList" resultMap="BaseResultMap">
        SELECT
        <include refid="Base_Column_List"/>
        FROM erp_promotion_activity
        WHERE deleted = 0
        <if test="tenantId != null">
            AND tenant_id = #{tenantId}
        </if>
        <if test="name != null and name != ''">
            AND name LIKE CONCAT('%', #{name}, '%')
        </if>
        <if test="status != null and status != ''">
            AND status = #{status}
        </if>
        <if test="type != null and type != ''">
            AND type = #{type}
        </if>
        ORDER BY create_time DESC
    </select>

</mapper>
