{
  "name": "ai-ready-admin",
  "version": "1.0.0",
  "description": "智企连·AI-Ready 管理前端",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:analyze": "vite build --mode analyze",
    "build:report": "vite build && start dist/stats.html",
    "preview": "vite preview",
    "lint": "eslint . --ext .vue,.js,.jsx,.cjs,.mjs,.ts,.tsx,.cts,.mts --fix",
    "lint:console": "eslint . --ext .vue,.js,.ts --rule 'no-console: error'",
    "test": "vitest",
    "test:coverage": "vitest run --coverage",
    "check-size": "npm run build && start dist/stats.html",
    "clean": "rm -rf dist node_modules/.vite"
  },
  "dependencies": {
    "@ant-design/icons-vue": "^7.0.1",
    "@sentry/vue": "^10.55.0",
    "ant-design-vue": "^4.1.0",
    "axios": "^1.6.0",
    "dayjs": "^1.11.10",
    "echarts": "^6.0.0",
    "lodash-es": "^4.17.21",
    "nprogress": "^0.2.0",
    "pinia": "^2.1.7",
    "playwright": "^1.60.0",
    "vue": "^3.4.0",
    "vue-echarts": "^8.0.1",
    "vue-i18n": "^9.14.5",
    "vue-router": "^4.3.0",
    "vxe-pc-ui": "^4.14.33",
    "vxe-table": "^4.19.10",
    "xe-utils": "^4.0.8",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^20.11.0",
    "@types/nprogress": "^0.2.3",
    "@typescript-eslint/eslint-plugin": "^6.19.0",
    "@typescript-eslint/parser": "^6.19.0",
    "@vitejs/plugin-vue": "^5.0.0",
    "@vue/test-utils": "^2.4.4",
    "eslint": "^8.56.0",
    "eslint-plugin-vue": "^9.21.0",
    "jsdom": "^29.0.2",
    "pinia-plugin-persistedstate": "^3.2.3",
    "rollup-plugin-visualizer": "^7.0.1",
    "sass-embedded": "^1.99.0",
    "terser": "^5.46.1",
    "typescript": "^5.3.0",
    "unplugin-auto-import": "^0.17.5",
    "unplugin-vue-components": "^0.26.0",
    "vite": "^5.1.0",
    "vite-plugin-compression": "^0.5.1",
    "vite-plugin-imagemin": "^0.6.1",
    "vitest": "^1.2.0",
    "vue-tsc": "^2.0.0"
  }
}
