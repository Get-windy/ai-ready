<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="cn.aiedge.base.mapper.SysTenantMenuMapper">

    <!-- 基础结果映射 -->
    <resultMap id="BaseResultMap" type="cn.aiedge.base.entity.SysTenantMenu">
        <id column="id" property="id"/>
        <result column="tenant_id" property="tenantId"/>
        <result column="menu_id" property="menuId"/>
        <result column="create_time" property="createTime"/>
    </resultMap>

    <!-- 通用查询列 -->
    <sql id="BaseColumns">
        id, tenant_id, menu_id, create_time
    </sql>

    <!-- 根据租户ID查询已授权的菜单ID列表 -->
    <select id="selectMenuIdsByTenantId" resultType="long">
        SELECT menu_id
        FROM sys_tenant_menu
        WHERE tenant_id = #{tenantId}
    </select>

    <!-- 批量插入租户菜单授权 -->
    <insert id="batchInsert">
        INSERT INTO sys_tenant_menu (id, tenant_id, menu_id, create_time)
        VALUES
        <foreach collection="list" item="item" separator=",">
            (#{item.id}, #{item.tenantId}, #{item.menuId}, #{item.createTime})
        </foreach>
    </insert>

    <!-- 根据租户ID删除所有授权 -->
    <delete id="deleteByTenantId">
        DELETE FROM sys_tenant_menu
        WHERE tenant_id = #{tenantId}
    </delete>

    <!-- 根据菜单ID删除所有关联 -->
    <delete id="deleteByMenuId">
        DELETE FROM sys_tenant_menu
        WHERE menu_id = #{menuId}
    </delete>

</mapper>
