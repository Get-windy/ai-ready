# ── 数据库 ──
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_password_here
DB_NAME=devdb

# ── 数据源登录（ql361.com） ──
SOURCE_USERNAME=13800000000
SOURCE_PASSWORD=your_password

# ── 同步配置 ──
PAGE_SIZE=100
PAGE_DELAY=0.5
MAX_RETRIES=3
RETRY_DELAY=2.0

# ── 调度 ──
SCHEDULE_FULL_SYNC_CRON=0 3 * * 0
SCHEDULE_INCR_SYNC_CRON=*/30 * * * *

# ── 日志 ──
LOG_LEVEL=INFO

# ── 报表名称映射（从浏览器 DevTools 获取） ──
# REPORT_NAMES={"601":"SaleOutBound","604":"SaleOrder","504":"PurchaseOrder","801":"Receipt"}
