# Data
data/
*.sql
*.dump
# ⚠️ 例外：Flyway 迁移是**源码**而非数据产物，必须纳入版本控制。
# 上面的 `*.sql` 会把 backend/core/api/core-api/src/main/resources/db/migration/ 下的新迁移
# 变成对 git 完全不可见（连 `git status` 的 `??` 都不显示），导致静默漏提交、
# 干净检出后 Flyway 找不到文件、库结构与应用不一致。故此处按路径取反。
!backend/core/api/core-api/src/main/resources/db/migration/*.sql
# ⚠️ 例外：tools/ 下的运维 SQL 同样是**源码**（如总账重算 tools/recalc-finance-ledger.sql），
# 靠它才能在任何环境复现同一套数据订正；被 `*.sql` 吞掉会导致别人拿不到脚本、只能口头传递。
!tools/*.sql

# Test
coverage/
.nyc_output/
*.gcov

# Playwright / E2E 产物（HTML 报告与运行状态，不入库）
playwright-report/
test-results/

# Build
dist/
build/
out/

# Node.js
node_modules/
*.tsbuildinfo

# Python（tools/ 下脚本的运行产物，不入库）
__pycache__/
*.pyc
*.pyo

# Maven flatten 插件的中间产物（每次构建按 ${revision} 重新生成，clean 阶段自删）
**/.flattened-pom.xml

# Agent documentation files
**/AGENTS.md

# Windows reserved name
nul
# Build artifacts
backend/BOOT-INF/
backend/*.jar
# 临时 fat jar 备份（<module>-run.jar.bak-<时间> 等，超出 Gitee 100MB 单文件配额）
backend/*.jar.*
backend/cn/

# 运行期上传目录（本地存储产物，不入库）
**/uploads/

# Tool outputs / runtime stderr
*.err
tool-results/

# 商标初筛脚本用的浏览器临时 profile（Chromium 缓存/凭据，约 12MB，绝不入库）
tools/.tm-clearance-profile/
tools/tm-clearance-cache.json
tools/tm-clearance-run.log
tools/tm-clearance-result.json

# AtCode tool runtime
**/.atcode/
