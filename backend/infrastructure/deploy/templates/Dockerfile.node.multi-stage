# Multi-stage Dockerfile for Node.js Applications
# Optimized for AI-Ready project frontend services

# Stage 1: Builder - Install dependencies and build
FROM node:18-alpine AS builder

# Set environment variables
ENV NODE_ENV=production
ENV PNPM_HOME="/pnpm"
ENV PATH="$PNPM_HOME:$PATH"
ENV CI=true

# Install pnpm globally
RUN corepack enable && corepack prepare pnpm@latest --activate

# Set working directory
WORKDIR /app

# Copy package files
COPY package.json pnpm-lock.yaml* ./

# Install dependencies (frozen lockfile for reproducibility)
RUN pnpm install --frozen-lockfile --prod=false

# Copy source code
COPY . .

# Build application
RUN pnpm run build

# Stage 2: Production dependencies - Install only production dependencies
FROM node:18-alpine AS deps

ENV NODE_ENV=production
ENV PNPM_HOME="/pnpm"
ENV PATH="$PNPM_HOME:$PATH"

RUN corepack enable && corepack prepare pnpm@latest --activate

WORKDIR /app

# Copy package files
COPY package.json pnpm-lock.yaml* ./

# Install production dependencies only
RUN pnpm install --frozen-lockfile --prod

# Stage 3: Runner - Production-ready image
FROM node:18-alpine AS runner

# Set environment variables
ENV NODE_ENV=production
ENV PORT=3000
ENV HOST=0.0.0.0
ENV NODE_OPTIONS="--max-old-space-size=512 --enable-source-maps"
ENV TZ=Asia/Shanghai

# Create non-root user
RUN addgroup --system --gid 1001 nodejs && \
    adduser --system --uid 1001 nodejs

# Install necessary tools
RUN apk add --no-cache \
    curl \
    tzdata \
    dumb-init

# Create app directory
WORKDIR /app

# Copy package files and production dependencies from deps stage
COPY --from=deps /app/node_modules ./node_modules
COPY --from=builder /app/package.json ./package.json

# Copy built application from builder stage
COPY --from=builder /app/dist ./dist
COPY --from=builder /app/public ./public

# Copy configuration files if they exist
COPY --from=builder /app/*.config.* ./
COPY --from=builder /app/*.env* ./

# Set proper permissions
RUN chown -R nodejs:nodejs /app && \
    chmod -R 755 /app

# Switch to non-root user
USER nodejs

# Expose port
EXPOSE $PORT

# Health check
HEALTHCHECK --interval=30s --timeout=3s --start-period=10s --retries=3 \
    CMD curl -f http://localhost:$PORT/health || exit 1

# Use dumb-init as entrypoint
ENTRYPOINT ["dumb-init"]

# Default command
CMD ["node", "dist/main.js"]

# Labels for better image management
LABEL maintainer="devops@aiedge.cn" \
      version="1.0.0" \
      description="AI-Ready Node.js Service" \
      org.opencontainers.image.source="https://github.com/aiedge/ai-ready" \
      org.opencontainers.image.title="AI-Ready Node.js Service" \
      org.opencontainers.image.description="Optimized Node.js service for AI-Ready platform" \
      org.label-schema.schema-version="1.0" \
      org.label-schema.name="ai-ready-node-service" \
      org.label-schema.vendor="AIEdge"

# Stage 4: Nginx serving (optional, for static sites)
FROM nginx:alpine AS nginx-runner

# Remove default nginx configuration
RUN rm /etc/nginx/conf.d/default.conf

# Copy custom nginx configuration
COPY nginx.conf /etc/nginx/conf.d/

# Copy built files from builder stage
COPY --from=builder /app/dist /usr/share/nginx/html

# Set proper permissions
RUN chown -R nginx:nginx /usr/share/nginx/html && \
    chmod -R 755 /usr/share/nginx/html

# Health check for nginx
HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
    CMD curl -f http://localhost/ || exit 1

# Expose port
EXPOSE 80

# Labels for nginx image
LABEL maintainer="devops@aiedge.cn" \
      version="1.0.0" \
      description="AI-Ready Nginx Static Server" \
      org.opencontainers.image.title="AI-Ready Nginx Static Server"

# Stage 5: Security scanner (optional, for CI/CD pipelines)
FROM aquasec/trivy:latest AS scanner

WORKDIR /scan
COPY --from=runner / /
RUN trivy filesystem --security-checks vuln,config,secret --exit-code 0 --no-progress / > /scan/report.txt

# Stage 6: Final image with security scan report
FROM runner AS final

# Copy security scan report
COPY --from=scanner /scan/report.txt /opt/security/scan-report.txt

# Create directory for security reports
RUN mkdir -p /opt/security && \
    chown nodejs:nodejs /opt/security && \
    chmod 755 /opt/security

# Final labels
LABEL security.scan="trivy" \
      security.scan.date="$(date -u +'%Y-%m-%dT%H:%M:%SZ')" \
      security.scan.version="0.45.0"