{
  "test_environment": {
    "name": "Sprint 27+1 测试环境",
    "base_url": "http://localhost:8080",
    "api_version": "v1",
    "description": "AI-Ready项目测试环境API接口自动化测试配置"
  },
  "test_users": [
    {
      "username": "test_admin",
      "password": "TestAdmin123!",
      "role": "admin",
      "permissions": ["read", "write", "delete", "manage"]
    },
    {
      "username": "test_user",
      "password": "TestUser123!",
      "role": "user",
      "permissions": ["read", "write"]
    },
    {
      "username": "test_viewer",
      "password": "TestViewer123!",
      "role": "viewer",
      "permissions": ["read"]
    }
  ],
  "test_products": [
    {
      "name": "测试产品A",
      "category": "electronics",
      "price_range": [100.0, 1000.0],
      "stock_range": [10, 100]
    },
    {
      "name": "测试产品B",
      "category": "clothing",
      "price_range": [50.0, 500.0],
      "stock_range": [20, 200]
    },
    {
      "name": "测试产品C",
      "category": "books",
      "price_range": [10.0, 100.0],
      "stock_range": [50, 500]
    }
  ],
  "test_files": [
    {
      "name": "test_document.txt",
      "type": "text/plain",
      "size_kb": 10,
      "description": "测试文本文件"
    },
    {
      "name": "test_data.csv",
      "type": "text/csv",
      "size_kb": 50,
      "description": "测试CSV数据文件"
    },
    {
      "name": "test_config.json",
      "type": "application/json",
      "size_kb": 5,
      "description": "测试配置文件"
    }
  ],
  "performance_benchmarks": {
    "restful_api": {
      "p95_response_time_ms": 500,
      "success_rate_percent": 99.0,
      "concurrent_users": 10
    },
    "graphql_api": {
      "p95_response_time_ms": 800,
      "success_rate_percent": 99.0,
      "query_complexity_limit": 100
    },
    "websocket": {
      "connection_time_ms": 1000,
      "message_latency_ms": 100,
      "reconnect_attempts": 3
    },
    "file_upload": {
      "small_file_time_ms": 1000,
      "large_file_time_ms": 5000,
      "max_file_size_mb": 10
    }
  },
  "test_schedule": {
    "smoke_tests": {
      "frequency": "daily",
      "tests": ["health_check", "authentication", "basic_crud"]
    },
    "regression_tests": {
      "frequency": "weekly",
      "tests": ["all_api_tests", "performance_tests", "error_handling"]
    },
    "performance_tests": {
      "frequency": "monthly",
      "tests": ["load_testing", "stress_testing", "endurance_testing"]
    }
  },
  "monitoring": {
    "metrics": [
      "api_response_time",
      "api_success_rate",
      "error_rate",
      "concurrent_connections",
      "resource_utilization"
    ],
    "alerts": [
      {
        "metric": "api_response_time",
        "threshold": 1000,
        "severity": "critical"
      },
      {
        "metric": "api_success_rate",
        "threshold": 95,
        "severity": "warning"
      },
      {
        "metric": "error_rate",
        "threshold": 5,
        "severity": "critical"
      }
    ]
  }
}