# Optimized Dockerfile for Nginx
# For API Gateway, reverse proxy, and static file serving

# Stage 1: Builder - Compile nginx with custom modules
FROM alpine:latest AS builder

# Install build dependencies
RUN apk add --no-cache \
    git \
    gcc \
    g++ \
    make \
    pkgconfig \
    openssl-dev \
    pcre-dev \
    zlib-dev \
    linux-headers \
    libxslt-dev \
    gd-dev \
    geoip-dev \
    perl-dev \
    libedit-dev \
    mercurial \
    bash \
    alpine-sdk \
    findutils

# Set working directory
WORKDIR /build

# Download nginx source
ARG NGINX_VERSION=1.24.0
RUN wget -O nginx-${NGINX_VERSION}.tar.gz https://nginx.org/download/nginx-${NGINX_VERSION}.tar.gz && \
    tar -xzf nginx-${NGINX_VERSION}.tar.gz

# Clone nginx modules
RUN git clone --depth 1 https://github.com/openresty/headers-more-nginx-module.git && \
    git clone --depth 1 https://github.com/openresty/set-misc-nginx-module.git && \
    git clone --depth 1 https://github.com/nginx-modules/ngx_cache_purge.git && \
    git clone --depth 1 https://github.com/nginx-modules/ngx_brotli.git && \
    git clone --depth 1 https://github.com/openresty/lua-nginx-module.git && \
    git clone --depth 1 https://github.com/simpl/ngx_devel_kit.git && \
    git clone --depth 1 https://github.com/openresty/luajit2.git

# Build LuaJIT
WORKDIR /build/luajit2
RUN make -j$(nproc) && make install

# Configure and compile nginx with modules
WORKDIR /build/nginx-${NGINX_VERSION}
RUN LUAJIT_LIB=/usr/local/lib LUAJIT_INC=/usr/local/include/luajit-2.1 \
    ./configure \
    --prefix=/etc/nginx \
    --sbin-path=/usr/sbin/nginx \
    --modules-path=/usr/lib/nginx/modules \
    --conf-path=/etc/nginx/nginx.conf \
    --error-log-path=/var/log/nginx/error.log \
    --http-log-path=/var/log/nginx/access.log \
    --pid-path=/var/run/nginx.pid \
    --lock-path=/var/run/nginx.lock \
    --http-client-body-temp-path=/var/cache/nginx/client_temp \
    --http-proxy-temp-path=/var/cache/nginx/proxy_temp \
    --http-fastcgi-temp-path=/var/cache/nginx/fastcgi_temp \
    --http-uwsgi-temp-path=/var/cache/nginx/uwsgi_temp \
    --http-scgi-temp-path=/var/cache/nginx/scgi_temp \
    --user=nginx \
    --group=nginx \
    --with-compat \
    --with-file-aio \
    --with-threads \
    --with-http_addition_module \
    --with-http_auth_request_module \
    --with-http_dav_module \
    --with-http_flv_module \
    --with-http_gunzip_module \
    --with-http_gzip_static_module \
    --with-http_mp4_module \
    --with-http_random_index_module \
    --with-http_realip_module \
    --with-http_secure_link_module \
    --with-http_slice_module \
    --with-http_ssl_module \
    --with-http_stub_status_module \
    --with-http_sub_module \
    --with-http_v2_module \
    --with-mail \
    --with-mail_ssl_module \
    --with-stream \
    --with-stream_realip_module \
    --with-stream_ssl_module \
    --with-stream_ssl_preread_module \
    --with-cc-opt='-O2 -g -pipe -Wall -Wp,-D_FORTIFY_SOURCE=2 -fexceptions -fstack-protector-strong --param=ssp-buffer-size=4 -grecord-gcc-switches -m64 -mtune=generic -fPIC' \
    --with-ld-opt='-Wl,-z,relro -Wl,-z,now -pie' \
    --add-module=/build/headers-more-nginx-module \
    --add-module=/build/set-misc-nginx-module \
    --add-module=/build/ngx_cache_purge \
    --add-module=/build/ngx_brotli \
    --add-module=/build/ngx_devel_kit \
    --add-module=/build/lua-nginx-module

# Compile nginx
RUN make -j$(nproc) && make install

# Stage 2: Runtime - Production-ready nginx
FROM alpine:latest AS runtime

# Install runtime dependencies
RUN apk add --no-cache \
    nginx \
    openssl \
    pcre \
    zlib \
    geoip \
    libgcc \
    libstdc++ \
    tzdata \
    curl \
    ca-certificates \
    dumb-init

# Create nginx user and group
RUN addgroup -S nginx && \
    adduser -S -D -H -s /sbin/nologin -G nginx nginx

# Create necessary directories
RUN mkdir -p /var/cache/nginx && \
    mkdir -p /var/log/nginx && \
    mkdir -p /etc/nginx/conf.d && \
    mkdir -p /etc/nginx/sites-available && \
    mkdir -p /etc/nginx/sites-enabled && \
    mkdir -p /usr/share/nginx/html && \
    chown -R nginx:nginx /var/cache/nginx /var/log/nginx /etc/nginx /usr/share/nginx/html && \
    chmod -R 755 /var/cache/nginx /var/log/nginx /etc/nginx /usr/share/nginx/html

# Copy compiled nginx from builder stage
COPY --from=builder /usr/sbin/nginx /usr/sbin/nginx
COPY --from=builder /usr/lib/nginx/modules /usr/lib/nginx/modules
COPY --from=builder /etc/nginx /etc/nginx

# Copy optimized nginx configuration
COPY nginx.conf /etc/nginx/nginx.conf
COPY mime.types /etc/nginx/mime.types

# Copy default site configuration
COPY default.conf /etc/nginx/conf.d/default.conf

# Copy Lua scripts if needed
COPY lua /etc/nginx/lua

# Set working directory
WORKDIR /etc/nginx

# Switch to nginx user
USER nginx

# Expose ports
EXPOSE 80
EXPOSE 443

# Health check
HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
    CMD curl -f http://localhost/ || exit 1

# Use dumb-init as entrypoint
ENTRYPOINT ["dumb-init"]

# Default command
CMD ["nginx", "-g", "daemon off;"]

# Labels for better image management
LABEL maintainer="devops@aiedge.cn" \
      version="1.0.0" \
      description="Optimized Nginx with custom modules" \
      org.opencontainers.image.source="https://github.com/aiedge/ai-ready" \
      org.opencontainers.image.title="AI-Ready Optimized Nginx" \
      org.opencontainers.image.description="Nginx optimized for AI-Ready platform with Lua support, Brotli compression, and security enhancements" \
      org.label-schema.schema-version="1.0" \
      org.label-schema.name="ai-ready-nginx" \
      org.label-schema.vendor="AIEdge" \
      nginx.version="${NGINX_VERSION}" \
      nginx.modules="headers-more,set-misc,cache-purge,brotli,lua"

# Stage 3: Security scanner
FROM aquasec/trivy:latest AS scanner

WORKDIR /scan
COPY --from=runtime / /
RUN trivy filesystem --security-checks vuln,config,secret --exit-code 0 --no-progress / > /scan/report.txt

# Stage 4: Final image with security scan report
FROM runtime AS final

# Copy security scan report
COPY --from=scanner /scan/report.txt /opt/security/scan-report.txt

# Create directory for security reports
RUN mkdir -p /opt/security && \
    chown nginx:nginx /opt/security && \
    chmod 755 /opt/security

# Final labels
LABEL security.scan="trivy" \
      security.scan.date="$(date -u +'%Y-%m-%dT%H:%M:%SZ')" \
      security.scan.version="0.45.0"