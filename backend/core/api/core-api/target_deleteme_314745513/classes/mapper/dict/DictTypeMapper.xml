<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="cn.aiedge.dict.mapper.DictTypeMapper">

    <resultMap id="BaseResultMap" type="cn.aiedge.dict.model.DictType">
        <id column="id" property="id"/>
        <result column="tenant_id" property="tenantId"/>
        <result column="dict_code" property="dictCode"/>
        <result column="dict_name" property="dictName"/>
        <result column="description" property="description"/>
        <result column="parent_id" property="parentId"/>
        <result column="sort_order" property="sortOrder"/>
        <result column="status" property="status"/>
        <result column="is_built_in" property="isBuiltIn"/>
        <result column="remark" property="remark"/>
        <result column="create_by" property="createBy"/>
        <result column="create_time" property="createTime"/>
        <result column="update_by" property="updateBy"/>
        <result column="update_time" property="updateTime"/>
        <result column="deleted" property="deleted"/>
    </resultMap>

    <select id="selectTree" resultMap="BaseResultMap">
        SELECT * FROM sys_dict_type
        WHERE deleted = 0
        <if test="tenantId != null">
            AND tenant_id = #{tenantId}
        </if>
        <if test="parentId != null">
            AND parent_id = #{parentId}
        </if>
        ORDER BY sort_order ASC, id ASC
    </select>

    <select id="selectByDictCode" resultMap="BaseResultMap">
        SELECT * FROM sys_dict_type
        WHERE deleted = 0
        AND dict_code = #{dictCode}
        <if test="tenantId != null">
            AND tenant_id = #{tenantId}
        </if>
        LIMIT 1
    </select>

    <select id="selectEnabled" resultMap="BaseResultMap">
        SELECT * FROM sys_dict_type
        WHERE deleted = 0
        AND status = 'ENABLED'
        <if test="tenantId != null">
            AND tenant_id = #{tenantId}
        </if>
        ORDER BY sort_order ASC, id ASC
    </select>

</mapper>