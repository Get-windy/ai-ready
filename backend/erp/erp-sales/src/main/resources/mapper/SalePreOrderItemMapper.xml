        <result column="tenant_id" property="tenantId"/>
        <result column="order_id" property="orderId"/>
        <result column="line_no" property="lineNo"/>

        <result column="product_id" property="productId"/>
        <result column="product_name" property="productName"/>
        <result column="product_code" property="productCode"/>
        <result column="barcode" property="barcode"/>
        <result column="image_url" property="imageUrl"/>
        <result column="specification" property="specification"/>
        <result column="model" property="model"/>
        <result column="origin" property="origin"/>
        <result column="brand" property="brand"/>

        <result column="unit" property="unit"/>
        <result column="pricing_unit" property="pricingUnit"/>
        <result column="small_unit" property="smallUnit"/>
        <result column="small_unit_quantity" property="smallUnitQuantity"/>
        <result column="conversion_relation" property="conversionRelation"/>
        <result column="conversion_result" property="conversionResult"/>

        <result column="region" property="region"/>
        <result column="location" property="location"/>
        <result column="available_stock" property="availableStock"/>
        <result column="available_stock_conversion" property="availableStockConversion"/>
        <result column="book_stock" property="bookStock"/>

        <result column="quantity" property="quantity"/>
        <result column="piece_quantity" property="pieceQuantity"/>
        <result column="big_pack" property="bigPack"/>
        <result column="mid_pack" property="midPack"/>
        <result column="small_pack" property="smallPack"/>
        <result column="ordered_quantity" property="orderedQuantity"/>
        <result column="un_ordered_quantity" property="unOrderedQuantity"/>
        <result column="shipped_quantity" property="shippedQuantity"/>
        <result column="un_shipped_quantity" property="unShippedQuantity"/>
        <result column="terminate_quantity" property="terminateQuantity"/>
        <result column="terminate_amount" property="terminateAmount"/>

        <result column="last_sale_date" property="lastSaleDate"/>
        <result column="retail_price" property="retailPrice"/>
        <result column="wholesale_price" property="wholesalePrice"/>
        <result column="min_sale_price" property="minSalePrice"/>
        <result column="unit_price" property="unitPrice"/>
        <result column="amount" property="amount"/>
        <result column="small_unit_price" property="smallUnitPrice"/>

        <result column="discount_rate" property="discountRate"/>
        <result column="discounted_price" property="discountedPrice"/>
        <result column="discounted_amount" property="discountedAmount"/>

        <result column="cost_price" property="costPrice"/>
        <result column="cost_amount" property="costAmount"/>
        <result column="gross_profit" property="grossProfit"/>

        <result column="volume" property="volume"/>
        <result column="weight" property="weight"/>

        <result column="product_attribute" property="productAttribute"/>
        <result column="gift" property="gift"/>
        <result column="remark" property="remark"/>

        <result column="price_level1" property="priceLevel1"/>
        <result column="price_level2" property="priceLevel2"/>
        <result column="price_level3" property="priceLevel3"/>
        <result column="price_level4" property="priceLevel4"/>
        <result column="price_level5" property="priceLevel5"/>
        <result column="price_level6" property="priceLevel6"/>
        <result column="price_level7" property="priceLevel7"/>
        <result column="price_level8" property="priceLevel8"/>

        <result column="ext_num1" property="extNum1"/>
        <result column="ext_num2" property="extNum2"/>
        <result column="ext_num3" property="extNum3"/>
        <result column="ext_num4" property="extNum4"/>
        <result column="ext_num5" property="extNum5"/>
        <result column="ext_text1" property="extText1"/>
        <result column="ext_text2" property="extText2"/>
        <result column="ext_partner" property="extPartner"/>
        <result column="ext_staff" property="extStaff"/>
        <result column="ext_dept" property="extDept"/>

        <!-- 主表字段（通过JOIN获取） -->
        <result column="order_no" property="orderNo"/>
        <result column="order_date" property="orderDate"/>
        <result column="status" property="status"/>
        <result column="customer_id" property="customerId"/>
        <result column="customer_name" property="customerName"/>
        <result column="customer_code" property="customerCode"/>
        <result column="customer_level" property="customerLevel"/>
        <result column="warehouse_id" property="warehouseId"/>
        <result column="warehouse_name" property="warehouseName"/>
        <result column="handler_id" property="handlerId"/>
        <result column="handler_name" property="handlerName"/>
        <result column="dept_name" property="deptName"/>
        <result column="sale_type" property="saleType"/>
        <result column="receiver_name" property="receiverName"/>
        <result column="receiver_phone" property="receiverPhone"/>
        <result column="shipping_address" property="shippingAddress"/>
        <result column="customer_ticket" property="customerTicket"/>
        <result column="customer_remark" property="customerRemark"/>
        <result column="summary" property="summary"/>
        <result column="attachment" property="attachment"/>
        <result column="order_remark" property="orderRemark"/>
