<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0           http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>cn.aiedge.erp</groupId>
    <artifactId>erp</artifactId>
    <version>0.3.3</version>
    <relativePath>../pom.xml</relativePath>
  </parent>
  <artifactId>erp-pricing</artifactId>
  <packaging>jar</packaging>
  <name>企智连·定价引擎模块</name>
  <description>智能定价引擎 - 支持多种定价策略、动态价格调整和价格记忆功能</description>
  <dependencies>
    <!-- 内部依赖 -->
    <dependency>
      <groupId>cn.aiedge</groupId>
      <artifactId>core-base</artifactId>
    </dependency>
    <!-- 往来单位模块 -->
    <dependency>
      <groupId>cn.aiedge.erp</groupId>
      <artifactId>erp-partner</artifactId>
      <version>${project.version}</version>
    </dependency>
    <!-- 产品库存模块 -->
    <dependency>
      <groupId>cn.aiedge.erp</groupId>
      <artifactId>erp-stock</artifactId>
      <version>${project.version}</version>
    </dependency>
    <!-- 客户等级功能已合并到 erp-partner -->
    <!-- Spring Boot Starter -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>
    <!-- MyBatis-Plus -->
    <dependency>
      <groupId>com.baomidou</groupId>
      <artifactId>mybatis-plus-spring-boot3-starter</artifactId>
    </dependency>
    <!-- Knife4j API文档 -->
    <dependency>
      <groupId>com.github.xiaoymin</groupId>
      <artifactId>knife4j-openapi3-jakarta-spring-boot-starter</artifactId>
    </dependency>

    <!-- Lombok -->
    <dependency>
      <groupId>org.projectlombok</groupId>
      <artifactId>lombok</artifactId>
      <scope>provided</scope>
    </dependency>

    <!-- Jackson XML (XmlMapper) -->
    <dependency>
      <groupId>com.fasterxml.jackson.dataformat</groupId>
      <artifactId>jackson-dataformat-xml</artifactId>
    </dependency>
    <!-- Test Dependencies -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter-api</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter-engine</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.mockito</groupId>
      <artifactId>mockito-core</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.mockito</groupId>
      <artifactId>mockito-junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

</project>