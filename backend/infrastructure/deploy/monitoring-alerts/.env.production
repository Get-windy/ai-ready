# AI-Ready 监控告警模块生产环境配置
# 创建日期: 2026-04-29
# 注意: 部署前请修改所有密码和敏感信息

# ==========================================
# 数据库配置 (PostgreSQL)
# ==========================================
DB_USER=monitoring_user
DB_PASSWORD=CHANGE_ME_STRONG_PASSWORD
DB_NAME=monitoring_db
POSTGRES_PORT=5433

# ==========================================
# Redis 缓存配置
# ==========================================
REDIS_PASSWORD=CHANGE_ME_STRONG_PASSWORD
REDIS_PORT=6380

# ==========================================
# RabbitMQ 消息队列配置
# ==========================================
RABBITMQ_USER=monitoring_rabbit
RABBITMQ_PASSWORD=CHANGE_ME_STRONG_PASSWORD
RABBITMQ_VHOST=monitoring_vhost
RABBITMQ_PORT=5673
RABBITMQ_MANAGEMENT_PORT=15673

# ==========================================
# 监控服务端口配置
# ==========================================
PROMETHEUS_PORT=9090
ALERTMANAGER_PORT=9093
GRAFANA_PORT=3000
CUSTOM_EXPORTER_PORT=9101
MONITORING_API_PORT=8081
NODE_EXPORTER_PORT=9100
NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443

# ==========================================
# Grafana 配置
# ==========================================
GRAFANA_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# ==========================================
# Prometheus 配置
# ==========================================
RETENTION_TIME=30d
RETENTION_SIZE=10GB

# ==========================================
# JVM 运行时配置
# ==========================================
JAVA_OPTS=-Xms512m -Xmx1024m -XX:+UseG1GC -XX:MaxGCPauseMillis=200

# ==========================================
# 数据收集配置
# ==========================================
COLLECT_INTERVAL=30