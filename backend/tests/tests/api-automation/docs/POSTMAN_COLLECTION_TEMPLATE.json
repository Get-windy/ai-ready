{
  "info": {
    "_postman_id": "qizhilian-api-template",
    "name": "企智连API测试集合模板",
    "description": "企智连系统API接口测试Postman集合模板，包含认证、ERP、CRM、系统管理等模块的标准化测试用例结构",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "version": "1.0.0"
  },
  "item": [
    {
      "name": "1. 认证模块",
      "description": "用户认证相关接口：登录、登出、Token刷新等",
      "item": [
        {
          "name": "TC-AUTH-001: 用户登录成功",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{test_username}}\",\n  \"password\": \"{{test_password}}\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/auth/login",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "auth", "login"]
            },
            "description": "正向测试：使用正确的用户名和密码登录，验证Token返回"
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "// 验证状态码",
                  "pm.test('状态码为200', function() {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "// 验证响应结构",
                  "pm.test('响应包含Token', function() {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.code).to.eql('0');",
                  "    pm.expect(jsonData.data.accessToken).to.exist;",
                  "    pm.expect(jsonData.data.refreshToken).to.exist;",
                  "});",
                  "",
                  "// 保存Token到环境变量",
                  "var jsonData = pm.response.json();",
                  "pm.environment.set('access_token', jsonData.data.accessToken);",
                  "pm.environment.set('refresh_token', jsonData.data.refreshToken);"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "TC-AUTH-002: 用户登录-密码错误",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{test_username}}\",\n  \"password\": \"WrongPassword123\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/auth/login",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "auth", "login"]
            },
            "description": "反向测试：使用错误的密码登录，验证401返回"
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('状态码为401', function() {",
                  "    pm.response.to.have.status(401);",
                  "});",
                  "",
                  "pm.test('返回认证错误信息', function() {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.code).to.eql('AUTH001');",
                  "    pm.expect(jsonData.message).to.include('用户名或密码错误');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "TC-AUTH-003: Token刷新",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{refresh_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/auth/refresh",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "auth", "refresh"]
            },
            "description": "使用Refresh Token获取新的Access Token"
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('状态码为200', function() {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('返回新的Token', function() {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.data.accessToken).to.exist;",
                  "    pm.expect(jsonData.data.accessToken).to.not.eql(pm.environment.get('access_token'));",
                  "});",
                  "",
                  "var jsonData = pm.response.json();",
                  "pm.environment.set('access_token', jsonData.data.accessToken);"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "TC-AUTH-004: 获取当前用户信息",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/auth/me",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "auth", "me"]
            },
            "description": "使用有效Token获取当前登录用户信息"
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('状态码为200', function() {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('返回用户信息', function() {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.data.id).to.exist;",
                  "    pm.expect(jsonData.data.username).to.exist;",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "TC-AUTH-005: 无Token访问受保护接口",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/v1/auth/me",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "auth", "me"]
            },
            "description": "安全测试：不携带Token访问需要认证的接口"
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('状态码为401', function() {",
                  "    pm.response.to.have.status(401);",
                  "});",
                  "",
                  "pm.test('返回未授权错误', function() {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.code).to.eql('AUTH002');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        }
      ]
    },
    {
      "name": "2. ERP模块",
      "description": "ERP核心功能接口：库存、采购、销售、财务",
      "item": [
        {
          "name": "TC-ERP-001: 创建入库单",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"warehouseId\": {{warehouse_id}},\n  \"items\": [\n    {\n      \"materialId\": {{material_id}},\n      \"quantity\": 100,\n      \"batchNo\": \"BATCH{{$timestamp}}\"\n    }\n  ],\n  \"remark\": \"测试入库单\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/inventory/inbound",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "inventory", "inbound"]
            },
            "description": "正向测试：创建入库单，验证库存增加"
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('状态码为200或201', function() {",
                  "    pm.expect(pm.response.code).to.be.oneOf([200, 201]);",
                  "});",
                  "",
                  "pm.test('返回入库单ID', function() {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.data.id).to.exist;",
                  "    pm.environment.set('inbound_order_id', jsonData.data.id);",
                  "});"
