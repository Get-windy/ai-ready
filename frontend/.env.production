# 生产环境配置
NODE_ENV=production
VITE_APP_ENV=production
VITE_APP_TITLE=AI-Ready

# API配置
VITE_API_BASE_URL=/api/v1
VITE_API_TIMEOUT=30000
VITE_API_ADMIN_URL=/api/admin
VITE_API_MOBILE_URL=/api/mobile

# 代理配置（生产环境通常不需要代理）
VITE_PROXY_TARGET=
VITE_PROXY_CHANGE_ORIGIN=false

# 应用配置
VITE_APP_VERSION=1.0.0
VITE_APP_BUILD_TIME=2026-04-30

# 功能开关
VITE_FEATURE_DEBUG=false
VITE_USE_MOCKS=false
VITE_FEATURE_MOCK_API=false
VITE_FEATURE_ANALYTICS=true

# 第三方服务
VITE_SENTRY_DSN=
VITE_GA_TRACKING_ID=

# 路径配置
VITE_PUBLIC_PATH=/
VITE_OUTPUT_DIR=dist

# 开发服务器配置（生产构建时使用）
VITE_DEV_SERVER_HOST=localhost
VITE_DEV_SERVER_PORT=5173
VITE_DEV_SERVER_HTTPS=false
