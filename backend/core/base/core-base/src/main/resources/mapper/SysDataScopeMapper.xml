<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="cn.aiedge.base.mapper.SysDataScopeMapper">

    <resultMap id="BaseResultMap" type="cn.aiedge.base.entity.SysDataScope">
        <id column="id" property="id"/>
        <result column="tenant_id" property="tenantId"/>
        <result column="role_id" property="roleId"/>
        <result column="rule_type" property="ruleType"/>
        <result column="target_table" property="targetTable"/>
        <result column="target_field" property="targetField"/>
        <result column="dept_ids" property="deptIds"/>
        <result column="custom_sql" property="customSql"/>
        <result column="remark" property="remark"/>
        <result column="status" property="status"/>
        <result column="deleted" property="deleted"/>
        <result column="version" property="version"/>
        <result column="create_by" property="createBy"/>
        <result column="create_time" property="createTime"/>
        <result column="update_by" property="updateBy"/>
        <result column="update_time" property="updateTime"/>
    </resultMap>

    <select id="selectByRoleIds" resultMap="BaseResultMap">
        SELECT * FROM sys_data_scope
        WHERE role_id IN
        <foreach collection="roleIds" item="roleId" open="(" separator="," close=")">
            #{roleId}
        </foreach>
        AND status = 1 AND deleted = 0
        ORDER BY target_table NULLS LAST
    </select>

    <select id="selectByRoleAndTable" resultMap="BaseResultMap">
        SELECT * FROM sys_data_scope
        WHERE role_id = #{roleId}
        AND (target_table = #{tableName} OR target_table IS NULL)
        AND status = 1 AND deleted = 0
        ORDER BY target_table NULLS LAST
        LIMIT 1
    </select>

</mapper>
