<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="cn.aiedge.dict.mapper.DictItemMapper">

    <resultMap id="BaseResultMap" type="cn.aiedge.dict.model.DictItem">
        <id column="id" property="id"/>
        <result column="tenant_id" property="tenantId"/>
        <result column="dict_type_id" property="dictTypeId"/>
        <result column="item_value" property="itemValue"/>
        <result column="item_text" property="itemText"/>
        <result column="description" property="description"/>
        <result column="parent_id" property="parentId"/>
        <result column="sort_order" property="sortOrder"/>
        <result column="status" property="status"/>
        <result column="is_default" property="isDefault"/>
        <result column="extra_attrs" property="extraAttrs"/>
        <result column="remark" property="remark"/>
        <result column="create_by" property="createBy"/>
        <result column="create_time" property="createTime"/>
        <result column="update_by" property="updateBy"/>
        <result column="update_time" property="updateTime"/>
        <result column="deleted" property="deleted"/>
    </resultMap>

    <select id="selectTree" resultMap="BaseResultMap">
        SELECT * FROM sys_dict_item
        WHERE deleted = 0
        <if test="dictTypeId != null">
            AND dict_type_id = #{dictTypeId}
        </if>
        <if test="parentId != null">
            AND parent_id = #{parentId}
        </if>
        ORDER BY sort_order ASC, id ASC
    </select>

    <select id="selectEnabledByType" resultMap="BaseResultMap">
        SELECT * FROM sys_dict_item
        WHERE deleted = 0
        AND dict_type_id = #{dictTypeId}
        AND status = 'ENABLED'
        ORDER BY sort_order ASC, id ASC
    </select>

    <select id="selectByDictCodeAndValue" resultMap="BaseResultMap">
        SELECT di.* FROM sys_dict_item di
        INNER JOIN sys_dict_type dt ON di.dict_type_id = dt.id
        WHERE di.deleted = 0
        AND dt.deleted = 0
        AND dt.dict_code = #{dictCode}
        AND di.item_value = #{itemValue}
        <if test="tenantId != null">
            AND di.tenant_id = #{tenantId}
        </if>
        LIMIT 1
    </select>

    <select id="selectByDictTypeIds" resultMap="BaseResultMap">
        SELECT * FROM sys_dict_item
        WHERE deleted = 0
        AND dict_type_id IN
        <foreach collection="dictTypeIds" item="dictTypeId" open="(" separator="," close=")">
            #{dictTypeId}
        </foreach>
        AND status = 'ENABLED'
        ORDER BY dict_type_id, sort_order ASC, id ASC
    </select>

    <select id="countByDictType" resultType="int">
        SELECT COUNT(*) FROM sys_dict_item
        WHERE deleted = 0
        AND dict_type_id = #{dictTypeId}
    </select>

</mapper>