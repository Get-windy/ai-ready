<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="cn.aiedge.base.mapper.SysSodRuleMapper">

    <resultMap id="BaseResultMap" type="cn.aiedge.base.entity.SysSodRule">
        <id column="id" property="id"/>
        <result column="tenant_id" property="tenantId"/>
        <result column="rule_name" property="ruleName"/>
        <result column="description" property="description"/>
        <result column="conflict_role_ids" property="conflictRoleIds"/>
        <result column="status" property="status"/>
        <result column="deleted" property="deleted"/>
        <result column="version" property="version"/>
        <result column="create_by" property="createBy"/>
        <result column="create_time" property="createTime"/>
        <result column="update_by" property="updateBy"/>
        <result column="update_time" property="updateTime"/>
    </resultMap>

    <select id="selectActiveRules" resultMap="BaseResultMap">
        SELECT * FROM sys_sod_rule
        WHERE status = 1 AND deleted = 0
    </select>

    <select id="selectByRoleId" resultMap="BaseResultMap">
        SELECT * FROM sys_sod_rule
        WHERE status = 1 AND deleted = 0
        AND conflict_role_ids LIKE CONCAT('%', #{roleId}, '%')
    </select>

</mapper>
