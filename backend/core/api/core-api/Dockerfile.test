# 多阶段构建Dockerfile
# 阶段1: 构建阶段
FROM maven:3.9.6-eclipse-temurin-17 AS builder
WORKDIR /app

# 复制pom.xml和源代码
COPY pom.xml .
COPY src ./src

# 下载依赖并构建
RUN mvn clean package -DskipTests -Dspring-boot.repackage.skip=false

# 阶段2: 运行阶段
FROM openjdk:17-jdk-slim
WORKDIR /app

# 设置时区
ENV TZ=Asia/Shanghai
RUN ln -snf /usr/share/zoneinfo/$TZ /etc/localtime && echo $TZ > /etc/timezone

# 创建非root用户
RUN groupadd -r ai-ready && useradd -r -g ai-ready -s /bin/false ai-ready
USER ai-ready

# 从构建阶段复制jar文件
COPY --from=builder /app/target/core-api-1.0.0-SNAPSHOT.jar app.jar

# 暴露端口
EXPOSE 8080

# 启动命令
ENTRYPOINT ["java", "-jar", "/app/app.jar"]