<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.aiready.menu.mapper.MenuMapper">

    <resultMap id="BaseResultMap" type="com.aiready.menu.entity.Menu">
        <id column="id" property="id"/>
        <result column="parent_id" property="parentId"/>
        <result column="menu_name" property="menuName"/>
        <result column="menu_code" property="menuCode"/>
        <result column="icon" property="icon"/>
        <result column="path" property="path"/>
        <result column="component" property="component"/>
        <result column="permissions" property="permissions"/>
        <result column="menu_type" property="menuType"/>
        <result column="sort_order" property="sortOrder"/>
        <result column="status" property="status"/>
        <result column="visible" property="visible"/>
        <result column="keep_alive" property="keepAlive"/>
        <result column="external" property="external"/>
        <result column="remark" property="remark"/>
        <result column="create_by" property="createBy"/>
        <result column="create_time" property="createTime"/>
        <result column="update_by" property="updateBy"/>
        <result column="update_time" property="updateTime"/>
        <result column="deleted" property="deleted"/>
    </resultMap>

    <sql id="Base_Column_List">
        id, parent_id, menu_name, menu_code, icon, path, component, permissions,
        menu_type, sort_order, status, visible, keep_alive, external, remark,
        create_by, create_time, update_by, update_time, deleted
    </sql>

    <!-- 获取用户菜单列表 -->
    <select id="selectMenusByUserId" resultMap="BaseResultMap">
        SELECT DISTINCT <include refid="Base_Column_List"/>
        FROM sys_menu m
        LEFT JOIN sys_role_menu rm ON m.id = rm.menu_id
        LEFT JOIN sys_user_role ur ON rm.role_id = ur.role_id
        WHERE ur.user_id = #{userId}
          AND m.status = 1
          AND m.deleted = 0
        ORDER BY m.sort_order ASC, m.id ASC
    </select>

    <!-- 获取角色菜单列表 -->
    <select id="selectMenusByRoleId" resultMap="BaseResultMap">
        SELECT DISTINCT <include refid="Base_Column_List"/>
        FROM sys_menu m
        LEFT JOIN sys_role_menu rm ON m.id = rm.menu_id
        WHERE rm.role_id = #{roleId}
          AND m.status = 1
          AND m.deleted = 0
        ORDER BY m.sort_order ASC, m.id ASC
    </select>

    <!-- 根据父ID查询子菜单 -->
    <select id="selectChildrenByParentId" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List"/>
        FROM sys_menu
        WHERE parent_id = #{parentId}
          AND deleted = 0
        ORDER BY sort_order ASC, id ASC
    </select>

    <!-- 检查菜单编码是否存在 -->
    <select id="checkMenuCodeExists" resultType="java.lang.Integer">
        SELECT COUNT(*) 
        FROM sys_menu 
        WHERE menu_code = #{menuCode} 
          AND deleted = 0
          <if test="excludeId != null">
              AND id != #{excludeId}
          </if>
    </select>

    <!-- 获取最大排序号 -->
    <select id="selectMaxSortOrder" resultType="java.lang.Integer">
        SELECT MAX(sort_order)
        FROM sys_menu
        WHERE parent_id = #{parentId}
          AND deleted = 0
    </select>

    <!-- 批量更新排序 -->
    <update id="batchUpdateSortOrder">
        <foreach collection="menus" item="item" separator=";">
            UPDATE sys_menu
            SET sort_order = #{item.sortOrder},
                update_time = NOW(),
                update_by = #{item.updateBy}
            WHERE id = #{item.id}
        </foreach>
    </update>

</mapper>