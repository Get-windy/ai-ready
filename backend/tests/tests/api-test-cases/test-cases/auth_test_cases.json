{
  "module": "认证模块",
  "basePath": "/api/v1/auth",
  "testCases": [
    {
      "id": "TC-AUTH-001",
      "title": "用户登录成功",
      "method": "POST",
      "path": "/login",
      "priority": "P0",
      "type": "正常场景",
      "precondition": "用户已注册且状态正常",
      "request": {
        "username": "admin",
        "password": "admin123"
      },
      "expected": {
        "statusCode": 200,
        "response": {
          "code": "0",
          "message": "success",
          "data": {
            "token": "notNull",
            "userId": "notNull",
            "username": "admin"
          }
        }
      }
    },
    {
      "id": "TC-AUTH-002",
      "title": "用户登录失败-密码错误",
      "method": "POST",
      "path": "/login",
      "priority": "P0",
      "type": "异常场景",
      "precondition": "用户已注册",
      "request": {
        "username": "admin",
        "password": "wrongpassword"
      },
      "expected": {
        "statusCode": 401,
        "response": {
          "code": "401",
          "message": "用户名或密码错误"
        }
      }
    },
    {
      "id": "TC-AUTH-003",
      "title": "用户登录失败-用户不存在",
      "method": "POST",
      "path": "/login",
      "priority": "P0",
      "type": "异常场景",
      "precondition": "",
      "request": {
        "username": "notexistuser",
        "password": "123456"
      },
      "expected": {
        "statusCode": 401,
        "response": {
          "code": "401",
          "message": "用户不存在"
        }
      }
    },
    {
      "id": "TC-AUTH-004",
      "title": "用户登录-用户名为空",
      "method": "POST",
      "path": "/login",
      "priority": "P1",
      "type": "边界值",
      "precondition": "",
      "request": {
        "username": "",
        "password": "admin123"
      },
      "expected": {
        "statusCode": 400,
        "response": {
          "code": "400",
          "message": "用户名不能为空"
        }
      }
    },
    {
      "id": "TC-AUTH-005",
      "title": "用户登录-密码为空",
      "method": "POST",
      "path": "/login",
      "priority": "P1",
      "type": "边界值",
      "precondition": "",
      "request": {
        "username": "admin",
        "password": ""
      },
      "expected": {
        "statusCode": 400,
        "response": {
          "code": "400",
          "message": "密码不能为空"
        }
      }
    },
    {
      "id": "TC-AUTH-006",
      "title": "Token刷新成功",
      "method": "POST",
      "path": "/refresh",
      "priority": "P1",
      "type": "正常场景",
      "precondition": "用户已登录，有有效refreshToken",
      "request": {
        "refreshToken": "${refreshToken}"
      },
      "expected": {
        "statusCode": 200,
        "response": {
          "code": "0",
          "data": {
            "token": "notNull",
            "refreshToken": "notNull"
          }
        }
      }
    },
    {
      "id": "TC-AUTH-007",
      "title": "获取当前用户信息",
      "method": "GET",
      "path": "/me",
      "priority": "P1",
      "type": "正常场景",
      "precondition": "用户已登录",
      "headers": {
        "Authorization": "Bearer ${token}"
      },
      "expected": {
        "statusCode": 200,
        "response": {
          "code": "0",
          "data": {
            "userId": "notNull",
            "username": "notNull",
            "roles": "notNull"
          }
        }
      }
    },
    {
      "id": "TC-AUTH-008",
      "title": "获取当前用户信息-Token无效",
      "method": "GET",
      "path": "/me",
      "priority": "P1",
      "type": "异常场景",
      "precondition": "",
      "headers": {
        "Authorization": "Bearer invalid_token"
      },
      "expected": {
        "statusCode": 401,
        "response": {
          "code": "401",
          "message": "Token无效或已过期"
        }
      }
    },
    {
      "id": "TC-AUTH-009",
      "title": "用户登出成功",
      "method": "POST",
      "path": "/logout",
      "priority": "P1",
      "type": "正常场景",
      "precondition": "用户已登录",
      "headers": {
        "Authorization": "Bearer ${token}"
      },
      "expected": {
        "statusCode": 200,
        "response": {
          "code": "0",
          "message": "登出成功"
        }
      }
    }
  ]
}
