{
  "name": "@ai-ready/ui-components",
  "version": "0.1.0",
  "description": "AI-Ready ERP系统统一前端组件库",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "types": "./dist/index.d.ts"
    },
    "./styles": {
      "import": "./dist/styles/index.css",
      "require": "./dist/styles/index.css"
    },
    "./themes/*": "./dist/themes/*.css"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "dev": "vite build --watch",
    "build": "vite build",
    "test": "vitest",
    "test:coverage": "vitest --coverage",
    "type-check": "vue-tsc --noEmit",
    "lint": "eslint . --ext .vue,.ts,.js",
    "format": "prettier --write \"**/*.{vue,ts,js,json,scss,css}\"",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "prepare": "pnpm run build"
  },
  "dependencies": {
    "vue": "^3.4.0",
    "@vueuse/core": "^10.9.0",
    "ant-design-vue": "^4.1.0",
    "@ant-design/icons-vue": "^7.0.1",
    "dayjs": "^1.11.10"
  },
  "peerDependencies": {
    "vue": "^3.0.0",
    "ant-design-vue": "^4.0.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.0.0",
    "typescript": "^5.4.0",
    "vite": "^5.0.0",
    "vitest": "^1.5.0",
    "@vue/test-utils": "^2.4.0",
    "vue-tsc": "^1.8.0",
    "eslint": "^9.0.0",
    "prettier": "^3.3.0",
    "@types/node": "^20.0.0",
    "sass": "^1.72.0",
    "@storybook/vue3-vite": "^8.3.0",
    "@storybook/vue3": "^8.3.0",
    "@storybook/addon-essentials": "^8.3.0",
    "@storybook/addon-interactions": "^8.3.0",
    "@storybook/addon-a11y": "^8.3.0",
    "@storybook/addon-links": "^8.3.0",
    "@storybook/manager-api": "^8.3.0",
    "@storybook/theming": "^8.3.0",
    "@storybook/test": "^8.3.0",
    "@storybook/blocks": "^8.3.0"
  },
  "keywords": [
    "vue",
    "ui",
    "components",
    "ant-design-vue",
    "erp",
    "ai-ready"
  ],
  "author": "AI-Ready Team",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/ai-ready/ai-ready-ui.git"
  },
  "bugs": {
    "url": "https://github.com/ai-ready/ai-ready-ui/issues"
  },
  "homepage": "https://github.com/ai-ready/ai-ready-ui#readme"
}