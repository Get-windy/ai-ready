{
  "module": "notification",
  "description": "企智连消息通知模块测试用例",
  "version": "1.0.0",
  "testSuites": [
    {
      "suiteId": "NOTIFY_SYSTEM_001",
      "suiteName": "系统通知测试",
      "description": "测试系统通知功能",
      "priority": "high",
      "testCases": [
        {
          "id": "NOTIFY_SYSTEM_001_001",
          "title": "公告发布测试",
          "description": "验证能够发布系统公告",
          "steps": [
            "1. 登录管理员账号",
            "2. 进入公告发布页面",
            "3. 填写公告标题和内容",
            "4. 选择发布范围",
            "5. 点击发布"
          ],
          "expectedResult": "公告发布成功，所有指定用户可见",
          "priority": "high",
          "type": "positive"
        },
        {
          "id": "NOTIFY_SYSTEM_001_002",
          "title": "公告接收测试",
          "description": "验证用户能够接收系统公告",
          "steps": [
            "1. 登录普通用户账号",
            "2. 查看公告列表",
            "3. 点击查看公告详情"
          ],
          "expectedResult": "公告正确显示，可查看详情",
          "priority": "high",
          "type": "positive"
        },
        {
          "id": "NOTIFY_SYSTEM_001_003",
          "title": "系统升级通知测试",
          "description": "验证能够发送系统升级通知",
          "steps": [
            "1. 进入系统通知管理",
            "2. 创建系统升级通知",
            "3. 设置升级时间和影响范围",
            "4. 发布通知"
          ],
          "expectedResult": "升级通知发送成功，用户可接收",
          "priority": "high",
          "type": "positive"
        },
        {
          "id": "NOTIFY_SYSTEM_001_004",
          "title": "维护通知测试",
          "description": "验证能够发送系统维护通知",
          "steps": [
            "1. 进入系统通知管理",
            "2. 创建维护通知",
            "3. 设置维护时间和范围",
            "4. 发布通知"
          ],
          "expectedResult": "维护通知发送成功",
          "priority": "high",
          "type": "positive"
        },
        {
          "id": "NOTIFY_SYSTEM_001_005",
          "title": "紧急通知测试",
          "description": "验证能够发送紧急通知",
          "steps": [
            "1. 进入紧急通知发布",
            "2. 填写紧急通知内容",
            "3. 设置推送方式（站内信/短信/邮件）",
            "4. 立即发送"
          ],
          "expectedResult": "紧急通知即时送达",
          "priority": "high",
          "type": "positive"
        }
      ]
