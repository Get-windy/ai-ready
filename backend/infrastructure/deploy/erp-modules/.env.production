# AI-Ready ERP 生产环境配置
# 创建日期: 2026-04-29
# 注意: 部署前请修改所有密码和敏感信息

# ==========================================
# 数据库配置 (PostgreSQL)
# ==========================================
DB_USER=erpadmin
DB_PASSWORD=CHANGE_ME_STRONG_PASSWORD
DB_HOST=postgres
DB_PORT=5432
DB_NAME=ai_ready_erp

# ==========================================
# Redis 缓存配置
# ==========================================
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD

# ==========================================
# Grafana 监控面板配置
# ==========================================
GRAFANA_USER=admin
GRAFANA_PASSWORD=CHANGE_ME_GRAFANA_PASSWORD

# ==========================================
# JVM 运行时配置
# ==========================================
JAVA_OPTS=-Xms512m -Xmx1024m -XX:+UseG1GC -XX:MaxGCPauseMillis=200

# ==========================================
# Spring Boot 配置
# ==========================================
SPRING_PROFILES_ACTIVE=prod

# ==========================================
# 应用服务端口 (宿主机映射)
# ==========================================
BATCH_SN_PORT=8081
INVOICE_PORT=8082
PURCHASE_EXCHANGE_PORT=8083
SALES_EXCHANGE_PORT=8084
SUPPLIER_PORTAL_PORT=8085

# ==========================================
# 监控配置
# ==========================================
PROMETHEUS_RETENTION=15d
GRAFANA_PLUGINS=postgres-datasource,redis-datasource

# ==========================================
# 日志配置
# ==========================================
LOG_LEVEL=INFO
LOG_PATH=/var/log/ai-ready/erp
