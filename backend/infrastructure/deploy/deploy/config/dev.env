# AI-Ready 开发环境配置
# 版本: v1.0.0

# 部署信息
ENV=dev
APP_NAME=ai-ready
APP_PORT=8080
APP_VERSION=latest

# 远程主机配置
DEPLOY_HOST=localhost
DEPLOY_USER=developer
REMOTE_APP_DIR=/opt/ai-ready/dev
REMOTE_LOG_DIR=/var/log/ai-ready/dev
REMOTE_BACKUP_DIR=/opt/ai-ready/backups/dev

# 数据库配置
DB_HOST=localhost
DB_PORT=5432
DB_NAME=ai_ready_dev
DB_USER=ai_ready
DB_PASSWORD=dev_password

# Redis配置
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Nacos配置
NACOS_HOST=localhost
NACOS_PORT=8848

# 日志级别
LOG_LEVEL=DEBUG

# JVM配置
JAVA_OPTS="-Xms512m -Xmx1024m -XX:+UseG1GC"

# 健康检查配置
HEALTH_CHECK_URL=http://localhost:8080/actuator/health
HEALTH_CHECK_TIMEOUT=60

# 通知配置
NOTIFY_ENABLED=false
NOTIFY_WEBHOOK=
