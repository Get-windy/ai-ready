# Multi-stage Dockerfile for Java Spring Boot Applications
# Optimized for AI-Ready project services

# Stage 1: Builder - Compile and package the application
FROM eclipse-temurin:17-jdk-jammy AS builder

# Set environment variables
ENV APP_HOME=/app
ENV BUILD_OPTS=""
ENV MAVEN_OPTS="-Dmaven.repo.local=/root/.m2/repository -DskipTests=true -Dmaven.test.skip=true"

# Set working directory
WORKDIR $APP_HOME

# Install system dependencies
RUN apt-get update && apt-get install -y \
    git \
    curl \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# Copy Maven wrapper and dependencies
COPY mvnw .
COPY .mvn .mvn
COPY pom.xml .

# Download Maven wrapper if needed
RUN chmod +x mvnw && \
    if [ ! -f "/root/.m2/wrapper/dists/apache-maven-*/bin/mvn" ]; then \
        ./mvnw dependency:go-offline; \
    fi

# Copy source code
COPY src src

# Build application
RUN ./mvnw clean package $BUILD_OPTS -DskipTests

# Stage 2: Dependency extractor - Extract dependencies for layer caching
FROM eclipse-temurin:17-jdk-jammy AS dependency-extractor

WORKDIR /app
COPY --from=builder /app/target/*.jar app.jar

# Extract layered jar
RUN java -Djarmode=layertools -jar app.jar extract

# Stage 3: Runtime - Production-ready image
FROM eclipse-temurin:17-jre-jammy AS runtime

# Set environment variables
ENV APP_HOME=/app
ENV JAVA_OPTS="-XX:+UseContainerSupport -XX:MaxRAMPercentage=75.0 -XX:+UseG1GC -XX:+HeapDumpOnOutOfMemoryError -XX:HeapDumpPath=/opt/traces -XX:NativeMemoryTracking=summary"
ENV SPRING_PROFILES_ACTIVE=production
ENV TZ=Asia/Shanghai

# Create non-root user
RUN groupadd -r spring && useradd -r -g spring spring

# Set working directory
WORKDIR $APP_HOME

# Copy dependencies from dependency-extractor stage
COPY --from=dependency-extractor /app/dependencies/ ./
COPY --from=dependency-extractor /app/spring-boot-loader/ ./
COPY --from=dependency-extractor /app/snapshot-dependencies/ ./
COPY --from=dependency-extractor /app/application/ ./

# Create necessary directories with proper permissions
RUN mkdir -p /opt/traces /opt/logs /opt/config && \
    chown -R spring:spring /opt/traces /opt/logs /opt/config $APP_HOME && \
    chmod -R 755 /opt/traces /opt/logs /opt/config

# Switch to non-root user
USER spring:spring

# Expose port (override in docker-compose if needed)
EXPOSE 8080

# Health check
HEALTHCHECK --interval=30s --timeout=3s --start-period=30s --retries=3 \
    CMD curl -f http://localhost:8080/actuator/health || exit 1

# Entry point
ENTRYPOINT ["java", "org.springframework.boot.loader.JarLauncher"]

# Default command (can be overridden)
CMD []

# Labels for better image management
LABEL maintainer="devops@aiedge.cn" \
      version="1.0.0" \
      description="AI-Ready Java Service" \
      org.opencontainers.image.source="https://github.com/aiedge/ai-ready" \
      org.opencontainers.image.title="AI-Ready Java Service" \
      org.opencontainers.image.description="Optimized Java Spring Boot service for AI-Ready platform" \
      org.label-schema.schema-version="1.0" \
      org.label-schema.name="ai-ready-java-service" \
      org.label-schema.vendor="AIEdge"

# Stage 4: Security scanner (optional, for CI/CD pipelines)
FROM aquasec/trivy:latest AS scanner

WORKDIR /scan
COPY --from=runtime / /
RUN trivy filesystem --security-checks vuln,config,secret --exit-code 0 --no-progress / > /scan/report.txt

# Stage 5: Final image with security scan report
FROM runtime AS final

# Copy security scan report
COPY --from=scanner /scan/report.txt /opt/security/scan-report.txt

# Final labels
LABEL security.scan="trivy" \
      security.scan.date="$(date -u +'%Y-%m-%dT%H:%M:%SZ')" \
      security.scan.version="0.45.0"