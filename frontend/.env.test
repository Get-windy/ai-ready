# 测试环境配置
NODE_ENV=test
VITE_APP_ENV=test
VITE_APP_TITLE=AI-Ready 测试环境

# API配置
VITE_API_BASE_URL=/api/v1
VITE_API_TIMEOUT=30000
VITE_API_ADMIN_URL=/api/admin
VITE_API_MOBILE_URL=/api/mobile

# 代理配置
VITE_PROXY_TARGET=http://localhost:8080
VITE_PROXY_CHANGE_ORIGIN=true

# 应用配置
VITE_APP_VERSION=1.0.0
VITE_APP_BUILD_TIME=2026-04-30

# 功能开关
VITE_FEATURE_DEBUG=true
VITE_USE_MOCKS=true
VITE_FEATURE_MOCK_API=true
VITE_FEATURE_ANALYTICS=false

# 第三方服务
VITE_SENTRY_DSN=
VITE_GA_TRACKING_ID=

# 路径配置
VITE_PUBLIC_PATH=/
VITE_OUTPUT_DIR=dist-test