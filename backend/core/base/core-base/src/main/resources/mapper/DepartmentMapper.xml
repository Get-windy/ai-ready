<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="cn.aiedge.base.mapper.DepartmentMapper">

    <!-- 根据部门编码查询部门 -->
    <select id="selectByDeptCode" resultType="cn.aiedge.base.entity.Department">
        SELECT * FROM sys_department WHERE dept_code = #{deptCode} AND deleted = 0
    </select>

    <!-- 查询子部门列表 -->
    <select id="selectByParentId" resultType="cn.aiedge.base.entity.Department">
        SELECT * FROM sys_department WHERE parent_id = #{parentId} AND deleted = 0
        ORDER BY sort ASC
    </select>

    <!-- 查询所有启用的部门 -->
    <select id="selectAllEnabled" resultType="cn.aiedge.base.entity.Department">
        SELECT * FROM sys_department WHERE deleted = 0 AND status = 1
        ORDER BY sort ASC
    </select>

    <!-- 根据祖级路径查询部门列表 -->
    <select id="selectByAncestors" resultType="cn.aiedge.base.entity.Department">
        SELECT * FROM sys_department 
        WHERE id IN 
        <foreach collection="ancestors.split(',')" item="id" open="(" separator="," close=")">
            #{id}
        </foreach>
        AND deleted = 0
        ORDER BY sort ASC
    </select>

</mapper>
