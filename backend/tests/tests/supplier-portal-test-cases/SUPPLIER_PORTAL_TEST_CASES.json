  "testSuites": [
    {
      "suiteId": "SUPP_REG_001",
      "suiteName": "供应商注册与认证测试",
      "description": "测试供应商注册与认证功能",
      "priority": "high",
      "testCases": [
        {
          "id": "SUPP_REG_001_001",
          "title": "供应商注册流程测试",
          "description": "验证供应商能够完成注册流程",
          "steps": [
            "1. 进入供应商注册页面",
            "2. 填写企业信息（名称、联系人、电话）",
            "3. 创建账号密码",
            "4. 提交注册申请"
          ],
          "expectedResult": "注册成功，提交审核",
          "priority": "high",
          "type": "positive"
        },
        {
          "id": "SUPP_REG_001_002",
          "title": "资质认证上传测试",
          "description": "验证资质认证文件能够成功上传",
          "steps": [
            "1. 进入资质认证页面",
            "2. 上传营业执照",
            "3. 上传法人身份证",
            "4. 上传其他资质文件"
          ],
          "expectedResult": "所有文件上传成功",
          "priority": "high",
          "type": "positive"
        },
        {
          "id": "SUPP_REG_001_003",
          "title": "审核状态查询测试",
          "description": "验证能够查询审核状态",
          "steps": [
            "1. 进入我的审核页面",
            "2. 查询审核状态"
          ],
          "expectedResult": "正确显示审核状态（待审核/审核中/已通过/已拒绝）",
          "priority": "medium",
          "type": "positive"
        },
        {
          "id": "SUPP_REG_001_004",
          "title": "账号激活测试",
          "description": "验证审核通过后账号可激活",
          "steps": [
            "1. 审核通过后登录",
            "2. 触发账号激活",
            "3. 验证功能权限"
          ],
          "expectedResult": "账号激活成功，权限正常",
          "priority": "high",
          "type": "positive"
        },
        {
          "id": "SUPP_REG_001_005",
          "title": "重复企业名称注册测试",
          "description": "验证重复企业名称无法注册",
          "steps": [
            "1. 使用已存在的企业名称",
            "2. 尝试注册"
          ],
          "expectedResult": "系统提示企业已存在",
          "priority": "medium",
          "type": "boundary"
        }
      ]
    },
