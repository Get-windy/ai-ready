<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="cn.aiedge.base.mapper.DataPermissionMapper">

    <!-- 根据角色ID列表查询数据权限 -->
    <select id="selectDataPermissionsByRoleIds" resultType="cn.aiedge.base.entity.DataPermission">
        SELECT *
        FROM sys_data_permission
        WHERE role_id IN
        <foreach collection="roleIds" item="roleId" open="(" separator="," close=")">
            #{roleId}
        </foreach>
        AND status = 0
        AND deleted = 0
    </select>

</mapper>