{
  "sqlInjectionTests": [
    {
      "name": "basic_sql_injection",
      "payloads": [
        "' OR '1'='1",
        "'; DROP TABLE users; --",
        "' UNION SELECT * FROM users; --",
        "' OR 1=1; --"
      ],
      "expectedResult": "blocked_or_error"
    }
  ],
  "xssTests": [
    {
      "name": "basic_xss",
      "payloads": [
        "<script>alert('XSS')</script>",
        "<img src=x onerror=alert('XSS')>",
        "<svg onload=alert('XSS')>"
      ],
      "expectedResult": "escaped_or_filtered"
    }
  ],
  "sensitiveDataTests": [
    {
      "name": "id_card_test",
      "data": {
        "idCard": "110101199001011234",
        "bankCard": "6228480012345678901",
        "phone": "13800138000",
        "email": "test@example.com"
      },
      "expectedEncryption": true
    }
  ]
}