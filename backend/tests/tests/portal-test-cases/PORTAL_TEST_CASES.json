      "priority": "high",
      "testCases": [
        {
          "id": "PORTAL_TRACK_004_001",
          "title": "订单状态展示测试",
          "description": "验证订单状态正确展示",
          "steps": [
            "1. 登录客户门户",
            "2. 进入我的订单",
            "3. 查看订单列表"
          ],
          "expectedResult": "订单列表显示订单状态（待付款/待发货/待收货/已完成）",
          "priority": "high",
          "type": "positive"
        },
        {
          "id": "PORTAL_TRACK_004_002",
          "title": "物流信息追踪测试",
          "description": "验证物流信息追踪功能",
          "steps": [
            "1. 进入订单详情页面",
            "2. 点击查看物流",
            "3. 验证物流信息"
          ],
          "expectedResult": "显示物流公司、运单号、物流轨迹",
          "priority": "high",
          "type": "positive"
        },
        {
          "id": "PORTAL_TRACK_004_003",
          "title": "订单详情查看测试",
          "description": "验证订单详情页面功能",
          "steps": [
            "1. 点击订单列表中的订单",
            "2. 进入订单详情页面",
            "3. 验证详情内容"
          ],
          "expectedResult": "订单详情包含商品信息、收货地址、支付信息、物流信息",
          "priority": "high",
          "type": "positive"
        },
        {
          "id": "PORTAL_TRACK_004_004",
          "title": "确认收货测试",
          "description": "验证确认收货功能",
          "steps": [
            "1. 进入待收货订单",
            "2. 点击确认收货",
            "3. 确认收货"
          ],
          "expectedResult": "订单状态更新为已完成",
          "priority": "high",
          "type": "positive"
        }
      ]
    },
    {
