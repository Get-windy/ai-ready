          "title": "资产负债表报表生成测试",
          "priority": "P0",
          "type": "功能测试",
          "precondition": "系统已初始化，存在财务数据",
          "steps": [
            "登录系统，进入财务管理模块",
            "选择报表查询 > 资产负债表",
            "设置查询日期范围为当前会计期间",
            "点击生成报表按钮"
          ],
          "expected": [
            "报表成功生成",
            "显示资产、负债、所有者权益三大部分",
            "资产总计 = 负债总计 + 所有者权益总计",
            "数据与总账一致"
          ],
          "automation": true
        },
