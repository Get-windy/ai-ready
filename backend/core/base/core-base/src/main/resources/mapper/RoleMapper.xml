<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="cn.aiedge.base.mapper.RoleMapper">

    <!--
      根据角色编码查询角色。

      ⚠️ 同 `selectByUserId`：`sys_role.status` 是「0 = 启用 / 1 = 停用」，
      这里必须写 `status = 0`，不要写 1。

      2026-09-19 加固：本查询被 `WorkflowServiceImpl` 用于解析 `approverType=role` 的审批人
      （先按 roleCode 查角色、再经 `sys_user_role` 取用户），此前只过滤 deleted，
      停用的角色仍能解析出审批人 ⇒ 审批授权未收回。今天零行为变化。
    -->
    <select id="selectByRoleCode" resultType="cn.aiedge.base.entity.SysRole">
        SELECT * FROM sys_role WHERE role_code = #{roleCode} AND deleted = 0 AND status = 0
    </select>

    <!-- 根据用户ID查询角色列表 -->
    <!--
      ⚠️ 状态取值不要改回 1：`sys_role.status` 是「0 = 启用 / 1 = 停用」
      （见 `PermissionInitializationConfig:152/178/204` 的 `setStatus(0); // 启用`，
        且 devdb 现有 5 个角色**全部**为 0）。
      原写 `r.status = 1` 等于「只取停用角色」→ 该查询**恒返回空**
      → `UserServiceImpl` 的用户详情角色、`RoleServiceImpl` 的用户角色 全部空值
      （2026-09-19 实测定位并修复）。
    -->
    <select id="selectByUserId" resultType="cn.aiedge.base.entity.SysRole">
        SELECT r.* FROM sys_role r
        INNER JOIN sys_user_role ur ON r.id = ur.role_id
        WHERE ur.user_id = #{userId} AND r.deleted = 0 AND r.status = 0
        ORDER BY r.sort ASC
    </select>

    <!-- 查询子角色列表 -->
    <select id="selectByParentId" resultType="cn.aiedge.base.entity.SysRole">
        SELECT * FROM sys_role WHERE parent_id = #{parentId} AND deleted = 0
        ORDER BY sort ASC
    </select>

</mapper>
