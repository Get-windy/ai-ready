# AI-Ready 测试环境配置
# 版本: v1.0.0

# 部署信息
ENV=staging
APP_NAME=ai-ready
APP_PORT=8080
APP_VERSION=latest

# 远程主机配置
DEPLOY_HOST=staging.ai-ready.cn
DEPLOY_USER=deploy
REMOTE_APP_DIR=/opt/ai-ready/staging
REMOTE_LOG_DIR=/var/log/ai-ready/staging
REMOTE_BACKUP_DIR=/opt/ai-ready/backups/staging

# 数据库配置
DB_HOST=staging-db.ai-ready.cn
DB_PORT=5432
DB_NAME=ai_ready_staging
DB_USER=ai_ready
DB_PASSWORD=staging_password

# Redis配置
REDIS_HOST=staging-redis.ai-ready.cn
REDIS_PORT=6379
REDIS_PASSWORD=staging_redis_pass

# Nacos配置
NACOS_HOST=staging-nacos.ai-ready.cn
NACOS_PORT=8848

# 日志级别
LOG_LEVEL=INFO

# JVM配置
JAVA_OPTS="-Xms1024m -Xmx2048m -XX:+UseG1GC -XX:MaxGCPauseMillis=200"

# 健康检查配置
HEALTH_CHECK_URL=http://staging.ai-ready.cn:8080/actuator/health
HEALTH_CHECK_TIMEOUT=120

# 通知配置
NOTIFY_ENABLED=true
NOTIFY_WEBHOOK=https://hooks.slack.com/services/YOUR/WEBHOOK/URL
