# AI-Ready API 优化版 Dockerfile
# 版本: v3.0 - 极致优化
# 优化目标: 构建时间 < 2分钟, 镜像体积 < 200MB

# ============ 阶段1: 依赖缓存 ============
FROM eclipse-temurin:21-jdk-alpine AS deps

WORKDIR /build

# 安装必要的构建工具
RUN apk add --no-cache curl ca-certificates

# 复制Maven包装器和配置
COPY .mvn .mvn
COPY mvnw pom.xml ./

# 下载依赖（利用Docker缓存层）
RUN ./mvnw dependency:go-offline -B -q && \
    ./mvnw dependency:resolve-plugins -B -q

# ============ 阶段2: 构建应用 ============
FROM eclipse-temurin:21-jdk-alpine AS builder

WORKDIR /build

# 从deps阶段复制缓存的依赖
COPY --from=deps /root/.m2 /root/.m2
COPY .mvn .mvn
COPY mvnw pom.xml ./

# 复制源代码
COPY src ./src

# 构建应用（跳过测试，使用并行构建）
RUN ./mvnw clean package -DskipTests -B -q \
    -Dmaven.compile.parallel=true \
    -T 1C

# 解压分层JAR
RUN java -Djarmode=layertools -jar target/*.jar extract --destination extracted && \
    rm -rf target/*.jar

# ============ 阶段3: 生产镜像 ============
FROM eclipse-temurin:21-jre-alpine

LABEL maintainer="devops@ai-ready.com"
LABEL version="3.0"
LABEL description="AI-Ready API Optimized Image"

# 构建参数
ARG BUILD_DATE
ARG VERSION
ARG GIT_SHA

LABEL build-date="${BUILD_DATE}"
LABEL version="${VERSION}"
LABEL git-sha="${GIT_SHA}"

# 安装必要工具（精简版）
RUN apk add --no-cache \
    curl=~8.5 \
    tzdata \
    && cp /usr/share/zoneinfo/Asia/Shanghai /etc/localtime \
    && echo "Asia/Shanghai" > /etc/timezone \
    && apk del tzdata

# 创建非root用户
RUN addgroup -S ai-ready -g 1000 && \
    adduser -S ai-ready -G ai-ready -u 1000

WORKDIR /app

# 分层复制（优化缓存）
COPY --from=builder --chown=ai-ready:ai-ready /build/extracted/dependencies/ ./
COPY --from=builder --chown=ai-ready:ai-ready /build/extracted/spring-boot-loader/ ./
COPY --from=builder --chown=ai-ready:ai-ready /build/extracted/snapshot-dependencies/ ./
COPY --from=builder --chown=ai-ready:ai-ready /build/extracted/application/ ./

# 设置权限
RUN chown -R ai-ready:ai-ready /app

# 切换到非root用户
USER ai-ready

# 暴露端口
EXPOSE 8080

# JVM参数优化
ENV JAVA_OPTS="\
    -server \
    -Xms512m -Xmx1024m \
    -XX:+UseG1GC \
    -XX:MaxGCPauseMillis=200 \
    -XX:+UseStringDeduplication \
    -XX:+OptimizeStringConcat \
    -Djava.security.egd=file:/dev/./urandom \
    -Dspring.backgroundpreinitializer.ignore=true \
    -Dspring.jmx.enabled=false"

ENV SPRING_PROFILES_ACTIVE="production"

# 健康检查
HEALTHCHECK --interval=30s --timeout=5s --start-period=60s --retries=3 \
    CMD curl -fs http://localhost:8080/actuator/health || exit 1

# 启动命令
ENTRYPOINT ["sh", "-c", "java $JAVA_OPTS org.springframework.boot.loader.launch.JarLauncher"]
