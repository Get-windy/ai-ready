<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="cn.aiedge.base.mapper.SysMenuMapper">

    <!-- 基础结果映射 -->
    <resultMap id="BaseResultMap" type="cn.aiedge.base.entity.SysMenu">
        <id column="id" property="id"/>
        <result column="tenant_id" property="tenantId"/>
        <result column="parent_id" property="parentId"/>
        <result column="menu_name" property="menuName"/>
        <result column="menu_code" property="menuCode"/>
        <result column="menu_type" property="menuType"/>
        <result column="path" property="path"/>
        <result column="component" property="component"/>
        <result column="route_name" property="routeName"/>
        <result column="redirect" property="redirect"/>
        <result column="icon" property="icon"/>
        <result column="sort" property="sort"/>
        <result column="is_external" property="isExternal"/>
        <result column="is_cache" property="isCache"/>
        <result column="visible" property="visible"/>
        <result column="status" property="status"/>
        <result column="client_type" property="clientType"/>
        <result column="biz_flow_tag" property="bizFlowTag"/>
        <result column="display_group" property="displayGroup"/>
        <result column="link_icon" property="linkIcon"/>
        <result column="remark" property="remark"/>
        <result column="deleted" property="deleted"/>
        <result column="create_time" property="createTime"/>
        <result column="update_time" property="updateTime"/>
    </resultMap>

    <!-- 通用查询列（含新增业务流向字段） -->
    <sql id="BaseColumns">
        id, tenant_id, parent_id, menu_name, menu_code, menu_type,
        path, component, route_name, redirect, icon, sort,
        is_external, is_cache, visible, status, client_type,
        biz_flow_tag, display_group, link_icon,
        remark, deleted, create_time, update_time
    </sql>

    <!-- ==================== 查询方法 ==================== -->

    <!-- 查询所有菜单（按租户过滤，含业务流向） -->
    <select id="selectAllMenus" resultMap="BaseResultMap">
        SELECT <include refid="BaseColumns"/>
        FROM sys_menu
        WHERE deleted = 0
        <if test="tenantId != null">
            AND tenant_id = #{tenantId}
        </if>
        ORDER BY sort ASC, id ASC
    </select>

    <!-- 查询用户可见的菜单列表 -->
    <select id="selectMenusByUserId" resultMap="BaseResultMap">
        SELECT DISTINCT <include refid="BaseColumns"/>
        FROM sys_menu m
        INNER JOIN sys_role_menu rm ON m.id = rm.menu_id
        INNER JOIN sys_user_role ur ON rm.role_id = ur.role_id
        WHERE ur.user_id = #{userId}
          AND m.deleted = 0
        ORDER BY m.sort ASC, m.id ASC
    </select>

    <!-- 查询子菜单 -->
    <select id="selectChildrenByParentId" resultMap="BaseResultMap">
        SELECT <include refid="BaseColumns"/>
        FROM sys_menu
        WHERE parent_id = #{parentId}
          AND deleted = 0
        <if test="tenantId != null">
            AND tenant_id = #{tenantId}
        </if>
        ORDER BY sort ASC, id ASC
    </select>

    <!-- 查询角色的菜单ID列表 -->
    <select id="selectMenuIdsByRoleId" resultType="long">
        SELECT menu_id
        FROM sys_role_menu
        WHERE role_id = #{roleId}
    </select>

    <!-- 根据角色ID列表查询菜单ID列表（忽略租户过滤） -->
    <select id="selectMenuIdsByRoleIds" resultType="long">
        SELECT DISTINCT menu_id
        FROM sys_role_menu
        WHERE role_id IN
        <foreach collection="roleIds" item="roleId" open="(" separator="," close=")">
            #{roleId}
        </foreach>
    </select>

    <!-- 根据菜单ID列表查询菜单（忽略租户过滤） -->
    <select id="selectMenusByIds" resultMap="BaseResultMap">
        SELECT <include refid="BaseColumns"/>
        FROM sys_menu
        WHERE id IN
        <foreach collection="menuIds" item="menuId" open="(" separator="," close=")">
            #{menuId}
        </foreach>
          AND deleted = 0
        ORDER BY sort ASC
    </select>

    <!-- 检查菜单编码是否存在 -->
    <select id="checkMenuCodeExists" resultType="int">
        SELECT COUNT(*)
        FROM sys_menu
        WHERE menu_code = #{menuCode}
          AND deleted = 0
        <if test="tenantId != null">
            AND tenant_id = #{tenantId}
        </if>
        <if test="excludeId != null">
            AND id != #{excludeId}
        </if>
    </select>

    <!-- 根据用户ID查询角色ID列表 -->
    <select id="selectRoleIdsByUserId" resultType="long">
        SELECT role_id
        FROM sys_user_role
        WHERE user_id = #{userId}
    </select>

</mapper>
