# AI-Ready 前端环境配置模板
# 复制此文件为 .env.development 或 .env.production 并填入实际值

# 环境标识
NODE_ENV=development
VITE_APP_ENV=development
VITE_APP_TITLE=AI-Ready 开发环境

# API 配置
VITE_API_BASE_URL=/api/v1
VITE_API_TIMEOUT=60000
VITE_API_ADMIN_URL=/api/admin
VITE_API_MOBILE_URL=/api/mobile

# 代理配置（开发环境）
VITE_PROXY_TARGET=http://localhost:8080
VITE_PROXY_CHANGE_ORIGIN=true

# 应用信息
VITE_APP_VERSION=1.0.0-dev
VITE_APP_BUILD_TIME=2026-01-01

# 功能开关
VITE_FEATURE_DEBUG=true
VITE_USE_MOCKS=false
VITE_FEATURE_MOCK_API=false
VITE_FEATURE_ANALYTICS=false

# 第三方服务（可选）
VITE_SENTRY_DSN=
VITE_GA_TRACKING_ID=

# 路径配置
VITE_PUBLIC_PATH=/
VITE_OUTPUT_DIR=dist

# 开发服务器配置
VITE_DEV_SERVER_HOST=localhost
VITE_DEV_SERVER_PORT=5173
VITE_DEV_SERVER_HTTPS=false
