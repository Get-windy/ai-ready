          "steps": [
            "1. 登录客户门户",
            "2. 访问购物车",
            "3. 访问订单列表"
          ],
          "expectedResult": "功能正常使用",
          "priority": "high",
          "type": "permission"
        },
        {
          "id": "PORTAL_AUTH_005_003",
          "title": "会话过期测试",
          "description": "验证会话过期后重新登录",
