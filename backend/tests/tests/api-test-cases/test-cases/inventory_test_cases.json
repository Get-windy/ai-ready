        "statusCode": 200,
        "response": {
          "code": "0",
          "data": {
            "list": "notNull"
          }
        }
      }
    },
    {
      "id": "TC-INV-008",
      "title": "库存查询-按物料筛选",
      "method": "GET",
      "path": "",
      "priority": "P1",
      "type": "正常场景",
      "precondition": "用户已登录",
      "headers": {
        "Authorization": "Bearer ${token}"
      },
      "queryParams": {
        "materialId": 1
      },
