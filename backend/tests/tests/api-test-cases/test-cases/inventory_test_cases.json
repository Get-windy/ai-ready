          }
        }
      }
    },
    {
      "id": "TC-INV-009",
      "title": "库存盘点创建",
      "method": "POST",
      "path": "/stock-check",
      "priority": "P1",
      "type": "正常场景",
      "precondition": "用户已登录，有盘点权限",
      "headers": {
        "Authorization": "Bearer ${token}"
      },
      "request": {
        "warehouseId": 1,
        "checkType": "FULL",
        "planDate": "2024-12-31",
        "remark": "年终盘点"
      },
      "expected": {
        "statusCode": 200,
        "response": {
          "code": "0",
          "data": {
            "id": "notNull",
            "checkNo": "notNull"
          }
        }
      }
    },
    {
      "id": "TC-INV-010",
      "title": "库存预警查询",
      "method": "GET",
      "path": "/alerts",
      "priority": "P1",
      "type": "正常场景",
      "precondition": "用户已登录",
      "headers": {
        "Authorization": "Bearer ${token}"
      },
