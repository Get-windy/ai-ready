# ERP批次管理模块环境变量配置示例
# 复制此文件为.env并根据实际情况修改

# ============== 数据库配置 ==============
DB_USER=erp_user
DB_PASSWORD=erp_password@123
DB_HOST=localhost
DB_PORT=15432
DB_NAME=erp_batch_db

# ============== Redis配置 ==============
REDIS_HOST=localhost
REDIS_PORT=16379
REDIS_PASSWORD=

# ============== RabbitMQ配置 ==============
RABBITMQ_USER=erp_user
RABBITMQ_PASSWORD=rabbit_password@123
RABBITMQ_HOST=localhost
RABBITMQ_PORT=25672

# ============== 应用配置 ==============
SPRING_PROFILES_ACTIVE=prod
SERVER_PORT=18080
LOG_LEVEL=INFO

# ============== JVM配置 ==============
JAVA_OPTS="-Xmx512m -Xms256m -XX:+UseG1GC -XX:MaxGCPauseMillis=200"

# ============== 监控配置 ==============
GRAFANA_USER=admin
GRAFANA_PASSWORD=grafana_admin@123
PROMETHEUS_PORT=19090
GRAFANA_PORT=13000

# ============== 镜像标签 ==============
TAG=latest

# ============== 部署路径 ==============
DEPLOY_PATH=/opt/erp/batch
LOG_PATH=${DEPLOY_PATH}/logs
BACKUP_PATH=${DEPLOY_PATH}/backups