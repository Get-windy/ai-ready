          "name": "TC-ERP-004: 库存数量边界值测试",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"warehouseId\": {{warehouse_id}},\n  \"items\": [\n    {\n      \"materialId\": {{material_id}},\n      \"quantity\": -10,\n      \"batchNo\": \"INVALID\"\n    }\n  ]\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/inventory/inbound",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "inventory", "inbound"]
            },
            "description": "边界值测试：入库数量为负数"
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
