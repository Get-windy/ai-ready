        <result column="deleted" property="deleted"/>
        <result column="create_time" property="createTime"/>
        <result column="update_time" property="updateTime"/>
    </resultMap>

    <!-- 分页查询预订货单明细视图（JOIN主表） -->
    <select id="selectDetailPage" resultMap="DetailResultMap">
        SELECT
            item.id, item.tenant_id, item.order_id, item.line_no,
            item.product_id, item.product_name, item.product_code, item.barcode,
            item.image_url, item.specification, item.model, item.origin, item.brand,
            item.unit, item.pricing_unit, item.small_unit, item.small_unit_quantity,
            item.conversion_relation, item.conversion_result,
            item.region, item.location,
            item.available_stock, item.available_stock_conversion, item.book_stock,
            item.quantity, item.piece_quantity,
            item.big_pack, item.mid_pack, item.small_pack,
            item.ordered_quantity, item.un_ordered_quantity,
            item.shipped_quantity, item.un_shipped_quantity,
            item.terminate_quantity, item.terminate_amount,
            item.last_sale_date, item.retail_price, item.wholesale_price, item.min_sale_price,
            item.unit_price, item.amount, item.small_unit_price,
            item.discount_rate, item.discounted_price, item.discounted_amount,
            item.cost_price, item.cost_amount, item.gross_profit,
            item.volume, item.weight,
            item.product_attribute, item.gift, item.remark,
            item.price_level1, item.price_level2, item.price_level3, item.price_level4,
            item.price_level5, item.price_level6, item.price_level7, item.price_level8,
            item.ext_num1, item.ext_num2, item.ext_num3, item.ext_num4, item.ext_num5,
            item.ext_text1, item.ext_text2,
            item.ext_partner, item.ext_staff, item.ext_dept,
            item.deleted, item.create_time, item.update_time,
            -- 主表字段
            o.order_no, o.order_date, o.status,
            o.customer_id, o.customer_name, o.customer_code, o.customer_level,
            o.warehouse_id, o.warehouse_name,
            o.handler_id, o.handler_name, o.dept_name,
            o.sale_type, o.receiver_name, o.receiver_phone, o.shipping_address,
            o.customer_ticket, o.customer_remark, o.summary, o.attachment,
            o.remark AS order_remark,
            o.creator_name, o.auditor_name, o.submit_time
        FROM erp_sale_pre_order_item item
        INNER JOIN erp_sale_pre_order o ON item.order_id = o.id AND o.deleted = 0
        WHERE item.deleted = 0
        <if test="keyword != null and keyword != ''">
            AND (item.product_name LIKE CONCAT('%', #{keyword}, '%')
                 OR item.product_code LIKE CONCAT('%', #{keyword}, '%')
                 OR item.barcode LIKE CONCAT('%', #{keyword}, '%'))
        </if>
        <if test="customerId != null">
            AND o.customer_id = #{customerId}
        </if>
        <if test="customerName != null and customerName != ''">
            AND o.customer_name LIKE CONCAT('%', #{customerName}, '%')
        </if>
        <if test="handlerName != null and handlerName != ''">
            AND o.handler_name LIKE CONCAT('%', #{handlerName}, '%')
        </if>
        <if test="deptName != null and deptName != ''">
            AND o.dept_name LIKE CONCAT('%', #{deptName}, '%')
        </if>
        <if test="orderNo != null and orderNo != ''">
            AND o.order_no LIKE CONCAT('%', #{orderNo}, '%')
        </if>
        <if test="status != null and status.size() > 0">
            AND o.status IN
            <foreach collection="status" item="s" open="(" separator="," close=")">
                #{s}
            </foreach>
        </if>
        <if test="settlementStatus != null">
            AND o.settlement_status = #{settlementStatus}
        </if>
        <if test="startDate != null and startDate != ''">
            AND o.order_date &gt;= #{startDate}::date
        </if>
        <if test="endDate != null and endDate != ''">
            AND o.order_date &lt;= #{endDate}::date
        </if>
        <if test="productAttribute != null and productAttribute != ''">
            AND item.product_attribute = #{productAttribute}
        </if>
        <if test="gift != null">
            AND item.gift = #{gift}
        </if>
        <if test="creatorName != null and creatorName != ''">
            AND o.creator_name LIKE CONCAT('%', #{creatorName}, '%')
        </if>
        <if test="auditorName != null and auditorName != ''">
            AND o.auditor_name LIKE CONCAT('%', #{auditorName}, '%')
        </if>
        <if test="saleType != null">
            AND o.sale_type = #{saleType}
        </if>
        <if test="remark != null and remark != ''">
            AND o.remark LIKE CONCAT('%', #{remark}, '%')
        </if>
        <if test="itemRemark != null and itemRemark != ''">
            AND item.remark LIKE CONCAT('%', #{itemRemark}, '%')
        </if>
        <!-- 商品分类下钻：分类树节点（含全部子孙分类）→ 商品 → 明细 -->
        <if test="categoryIds != null and categoryIds.size() > 0">
            AND EXISTS (
                SELECT 1 FROM erp_product p
                WHERE p.id = item.product_id AND p.deleted = 0
                  AND p.category_id IN
                  <foreach collection="categoryIds" item="cid" open="(" separator="," close=")">
                      #{cid}
                  </foreach>
            )
        </if>
        ORDER BY o.order_date DESC, o.order_no DESC, item.line_no ASC
    </select>

</mapper>
