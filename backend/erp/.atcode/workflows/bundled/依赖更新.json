{
  "name": "依赖更新",
  "description": "检查并更新项目依赖",
  "steps": [
    {
      "name": "检查过期依赖",
      "description": "检查过期的依赖包",
      "type": "bash",
      "content": "npm outdated || true"
    },
    {
      "name": "分析更新影响",
      "description": "分析依赖更新的影响",
      "type": "prompt",
      "content": "请分析检查到的过期依赖，评估更新可能带来的影响。关注：1. 版本变化 2. API 变化 3. 潜在的兼容性问题。给出更新建议。",
      "dependsOn": [
        "检查过期依赖"
      ]
    },
    {
      "name": "执行安全更新",
      "description": "执行安全更新",
      "type": "bash",
      "content": "npm update",
      "dependsOn": [
        "分析更新影响"
      ]
    }
  ]
}