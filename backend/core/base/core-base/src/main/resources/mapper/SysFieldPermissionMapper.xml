<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="cn.aiedge.base.mapper.SysFieldPermissionMapper">

    <resultMap id="BaseResultMap" type="cn.aiedge.base.entity.SysFieldPermission">
        <id column="id" property="id"/>
        <result column="tenant_id" property="tenantId"/>
        <result column="role_id" property="roleId"/>
        <result column="target_table" property="targetTable"/>
        <result column="target_field" property="targetField"/>
        <result column="visible" property="visible"/>
        <result column="mask_type" property="maskType"/>
        <result column="mask_char" property="maskChar"/>
        <result column="mask_prefix_len" property="maskPrefixLen"/>
        <result column="mask_suffix_len" property="maskSuffixLen"/>
        <result column="status" property="status"/>
        <result column="deleted" property="deleted"/>
        <result column="version" property="version"/>
        <result column="create_by" property="createBy"/>
        <result column="create_time" property="createTime"/>
        <result column="update_by" property="updateBy"/>
        <result column="update_time" property="updateTime"/>
    </resultMap>

    <select id="selectByRoleIds" resultMap="BaseResultMap">
        SELECT * FROM sys_field_permission
        WHERE role_id IN
        <foreach collection="roleIds" item="roleId" open="(" separator="," close=")">
            #{roleId}
        </foreach>
        AND status = 1 AND deleted = 0
    </select>

    <select id="selectByRoleAndTable" resultMap="BaseResultMap">
        SELECT * FROM sys_field_permission
        WHERE role_id IN
        <foreach collection="roleIds" item="roleId" open="(" separator="," close=")">
            #{roleId}
        </foreach>
        AND target_table = #{tableName}
        AND status = 1 AND deleted = 0
    </select>

</mapper>
